# Instagram историялар архиви созламалари

# Уланиш усули: instagram (Instagram Login, graph.instagram.com) ёки facebook (Facebook Login, Facebook саҳифага уланган аккаунт)
IG_API=instagram

# Instagram аккаунт ID. Instagram Login'да «me» қолдирса бўлади.
IG_USER_ID=me

# Архив папкаси (сайт папкасидан алоҳида)
ARCHIVE_DIR=/srv/ig-stories

# Токен шу файлда сақланади (refresh уни янгилайди). Токенни бу ерга ЁЗМАНГ.
TOKEN_FILE=/var/lib/ig-stories/token

# Фақат IG_API=facebook бўлса — токенни янгилаш учун Meta илова ID ва махфий калити
# FB_APP_ID=
# FB_APP_SECRET=

# API версияси (бўш — энг янгиси)
# IG_API_VERSION=
