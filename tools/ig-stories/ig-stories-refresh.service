[Unit]
Description=Instagram токенини янгилаш (qunduzxon)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=igstories
Group=igstories
ExecStart=/usr/bin/python3 /opt/ig-stories/ig_stories.py refresh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ig-stories
