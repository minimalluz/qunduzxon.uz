---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, TG_URL, PHONE } from '../config';
import defaultOg from '../assets/photos/hero.jpg';

export interface Crumb { href: string; label: string }
interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** Нон ушоқлари (бош саҳифасиз). Берилса, BreadcrumbList JSON-LD ҳам чиқади. */
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  /** Рус тилидаги версия манзили */
  ruHref?: string;
  noindex?: boolean;
  lang?: 'uz-Cyrl' | 'ru';
}
const lang = Astro.props.lang ?? 'uz-Cyrl';
const { title, description = SITE.description, image = defaultOg, crumbs, jsonLd = [], ruHref: wantedRu = '/ru/', noindex = false } = Astro.props;
// Рус тилидаги саҳифалар ҳозирча фақат /ru/ (бош саҳифа). Қолганлари таржима қилингач шу рўйхатга қўшилади.
const RU_PAGES = new Set(['/ru/']);
const ruHref = RU_PAGES.has(wantedRu) ? wantedRu : '/ru/';
const hasRuTwin = RU_PAGES.has(wantedRu) && Astro.url.pathname === '/uz/';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = lang === 'ru' ? title : title === SITE.name ?`${SITE.name} — ${SITE.roles.join(', ').toLowerCase()}` : `${title} — ${SITE.name}`;
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, SITE.url).href;

const ld = [...jsonLd];
if (crumbs?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ href: '/uz/', label: 'Бош саҳифа' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, SITE.url).href,
    })),
  });
}
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(hasRuTwin || lang === 'ru') && (
    <>
      <link rel="alternate" hreflang="uz" href={new URL('/uz/', SITE.url).href} />
      <link rel="alternate" hreflang="ru" href={new URL('/ru/', SITE.url).href} />
      <link rel="alternate" hreflang="x-default" href={new URL('/uz/', SITE.url).href} />
    </>
  )}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#1C1218" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'uz_UZ'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Асосий матнга ўтиш</a>
  <Header ruHref={ruHref} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <div class="mbar">
    <a class="btn tg" href={TG_URL} target="_blank" rel="noopener">Telegram</a>
    {PHONE ? <a class="btn call" href={`tel:${PHONE}`}>Қўнғироқ</a> : <a class="btn call" href={TG_URL} target="_blank" rel="noopener">Банд қилиш</a>}
  </div>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: #fff; padding: 8px 12px; border-radius: 8px; }
  .skip:focus { left: 8px; }
  .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(251,247,244,.95); backdrop-filter: blur(10px); border-top: 1px solid var(--color-line); }
  .mbar .btn { min-height: 46px; font-size: 14.5px; }
  .tg { background: #229ED9; color: #fff; }
  .call { background: var(--color-ink); color: #fff; }
  @media (min-width: 860px) { .mbar { display: none; } }
</style>
