---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, TG_URL, PHONE } from '../config';
import { HTML_LANG, OG_LOCALE, SITE_L, UI, swapLang, type Lang } from '../i18n';
import { allReviews } from '../lib/reviews';
import defaultOg from '../assets/photos/hero.jpg';

export interface Crumb { href: string; label: string }
interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** Нон ушоқлари (бош саҳифасиз). Берилса, BreadcrumbList JSON-LD ҳам чиқади. */
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  lang?: Lang;
}
const { lang = 'uz', title, crumbs, jsonLd = [], noindex = false } = Astro.props;
const site = SITE_L[lang];
const { description = site.description, image = defaultOg } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'uz' ? 'ru' : 'uz';

// Рус тилига таржима қилинган саҳифалар. Ҳар бирининг ўзбекча жуфти бор: /ru/x/ ↔ /uz/x/.
// Янги саҳифа қўшилса, шу рўйхатга ҳам қўшинг (шарҳлар `src/content/reviews-ru/` дан ўзи олинади).
const RU_PAGES = new Set([
  '/ru/',
  '/ru/about/',
  '/ru/onam/',
  '/ru/boshlovchi/',
  '/ru/boshlovchi/toy-va-tantanalar/',
  '/ru/boshlovchi/korporativ-tadbirlar/',
  '/ru/boshlovchi/tv-radio-ovoz/',
  '/ru/food-blog/',
  ...(await allReviews('ru')).map((r) => `/ru/food-blog/${r.id}/`),
  '/ru/hamkorlik/',
  '/ru/media/',
  '/ru/band-qilish/',
  '/ru/privacy-policy/',
]);
const path = Astro.url.pathname;
const ruPath = swapLang(path, 'ru');
const hasTwin = RU_PAGES.has(ruPath);
const uzUrl = new URL(swapLang(path, 'uz'), SITE.url).href;
const ruUrl = new URL(ruPath, SITE.url).href;
// Тил алмаштиргич: жуфти бўлса — шу саҳифанинг таржимасига, бўлмаса — бош саҳифага.
const altHref = hasTwin ? swapLang(path, other) : `/${other}/`;
const canonical = new URL(path, SITE.url).href;
const fullTitle = title === site.name ? `${site.name} — ${site.roles.join(', ').toLowerCase()}` : `${title} — ${site.name}`;
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, SITE.url).href;

const ld = [...jsonLd];
if (crumbs?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ href: `/${lang}/`, label: t.home }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, SITE.url).href,
    })),
  });
}
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hasTwin && !noindex && (
    <>
      <link rel="alternate" hreflang={HTML_LANG.uz} href={uzUrl} />
      <link rel="alternate" hreflang={HTML_LANG.ru} href={ruUrl} />
      <link rel="alternate" hreflang="x-default" href={uzUrl} />
    </>
  )}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#1C1218" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {hasTwin && <meta property="og:locale:alternate" content={OG_LOCALE[other]} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <Header lang={lang} altHref={altHref} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <div class="mbar">
    <a class="btn tg" href={TG_URL} target="_blank" rel="noopener">Telegram</a>
    {PHONE ? <a class="btn call" href={`tel:${PHONE}`}>{t.call}</a> : <a class="btn call" href={TG_URL} target="_blank" rel="noopener">{t.book}</a>}
  </div>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: #fff; padding: 8px 12px; border-radius: 8px; }
  .skip:focus { left: 8px; }
  .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(251,247,244,.95); backdrop-filter: blur(10px); border-top: 1px solid var(--color-line); }
  .mbar .btn { min-height: 46px; font-size: 14.5px; }
  .tg { background: #229ED9; color: #fff; }
  .call { background: var(--color-ink); color: #fff; }
  @media (min-width: 860px) { .mbar { display: none; } }
</style>
