---
// Расм (astro:assets): srcset ва lazy-load. rest — class ва ота компонентнинг стил атрибутлари (data-astro-cid-*).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; widths: number[]; sizes: string; loading?: 'lazy' | 'eager'; class?: string; [attr: string]: unknown }
const { src, alt, widths, sizes, loading = 'lazy', ...rest } = Astro.props;
---
<Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} {...rest} />
