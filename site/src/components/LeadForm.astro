---
import { DIRECTIONS, TURNSTILE_SITE_KEY } from '../config';
interface Props {
  /** Олдиндан танланган йўналиш */
  direction?: string;
  /** Тўлиқ форма (исм ва изоҳ билан) ёки қисқа «сана текшириш» формаси */
  full?: boolean;
  submitLabel?: string;
}
const { direction, full = false, submitLabel = 'Юбориш' } = Astro.props;
---
<form class="form lead-form" method="post" action="/api/lead" novalidate>
  {full && <label>Исмингиз<input name="name" autocomplete="name" required maxlength="80" /></label>}
  <label>Тадбир санаси<input type="date" name="date" /></label>
  <label class:list={{ full: !full }}>Йўналиш
    <select name="direction">
      {DIRECTIONS.map((d) => <option value={d.value} selected={d.value === direction}>{d.label}</option>)}
    </select>
  </label>
  <label class:list={['full']}>Телефон<input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+998 (__) ___-__-__" required /></label>
  {full && <label class="full">Изоҳ (ихтиёрий)<textarea name="comment" maxlength="1000"></textarea></label>}
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
  {TURNSTILE_SITE_KEY && <div class="cf-turnstile full" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only"></div>}
  <button class="btn btn-rose full" type="submit">{submitLabel}</button>
  <div class="form-msg full" role="status" aria-live="polite"></div>
</form>
{TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
</style>

<script>
  // +998 (XX) XXX-XX-XX маскаси
  const mask = (el: HTMLInputElement) => {
    let d = el.value.replace(/\D/g, '');
    if (!d.startsWith('998')) d = '998' + d;
    d = d.slice(0, 12);
    const p = d.slice(3);
    let o = '+998';
    if (p.length) o += ' (' + p.slice(0, 2);
    if (p.length >= 2) o += ')';
    if (p.length > 2) o += ' ' + p.slice(2, 5);
    if (p.length > 5) o += '-' + p.slice(5, 7);
    if (p.length > 7) o += '-' + p.slice(7, 9);
    el.value = o;
  };

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const tel = form.querySelector<HTMLInputElement>('input[name=phone]')!;
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    tel.addEventListener('input', () => mask(tel));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'form-msg full';
      if (tel.value.replace(/\D/g, '').length !== 12) {
        msg.textContent = 'Телефон рақамини тўлиқ киритинг.';
        msg.classList.add('err');
        tel.focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      data.page = location.href;
      btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        if (!res.ok) throw new Error(String(res.status));
        msg.textContent = 'Раҳмат! Аризангиз қабул қилинди, тез орада боғланамиз.';
        msg.classList.add('ok');
        form.reset();
      } catch {
        msg.textContent = 'Юборишда хато бўлди. Илтимос, Telegram орқали ёзинг.';
        msg.classList.add('err');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
