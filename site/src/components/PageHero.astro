---
import type { Crumb } from '../layouts/Base.astro';
interface Props { eyebrow?: string; crumbs?: Crumb[]; lead?: string }
const { eyebrow, crumbs = [], lead } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Нон ушоқлари">
        <a href="/uz/">Бош саҳифа</a>
        {crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">/</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1><slot /></h1>
    {lead && <p class="lead">{lead}</p>}
    <slot name="after" />
  </div>
</section>
