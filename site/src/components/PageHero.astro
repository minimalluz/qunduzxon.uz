---
import type { Crumb } from '../layouts/Base.astro';
import { UI, type Lang } from '../i18n';
interface Props { lang?: Lang; eyebrow?: string; crumbs?: Crumb[]; lead?: string }
const { lang = 'uz', eyebrow, crumbs = [], lead } = Astro.props;
const t = UI[lang];
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label={t.crumbs}>
        <a href={`/${lang}/`}>{t.home}</a>
        {crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">/</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1><slot /></h1>
    {lead && <p class="lead">{lead}</p>}
    <slot name="after" />
  </div>
</section>
