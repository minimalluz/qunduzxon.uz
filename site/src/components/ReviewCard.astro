---
import { Image } from 'astro:assets';
import { total, som, cuisineLabel, type Review } from '../lib/reviews';
import { UI, type Lang } from '../i18n';
interface Props { review: Review; lang?: Lang }
const { review, lang = 'uz' } = Astro.props;
const d = review.data;
const tx = review.t;
---
<article class="card rcard" data-cuisine={d.cuisine.join('|')} data-city={tx.city} data-score={total(review)} data-text={`${tx.title} ${tx.summary} ${tx.city}`.toLowerCase()}>
  <a href={`/${lang}/food-blog/${review.id}/`}>
    <div class="ph">
      <Image src={d.cover} alt={tx.title} widths={[400, 640]} sizes="(min-width:720px) 33vw, 100vw" loading="lazy" />
      <span class="score">{total(review).toFixed(1)}</span>
      {d.sample && <span class="smp">{UI[lang].sample}</span>}
    </div>
    <div class="bd">
      <h3>{tx.title}</h3>
      <div class="meta"><span>{d.cuisine.map((c) => cuisineLabel(c, lang)).join(' · ')}</span><span>{tx.city}</span><span>{som(d.averageCheck, lang)}</span></div>
      <p>{tx.summary}</p>
    </div>
  </a>
</article>

<style>
  .ph { position: relative; aspect-ratio: 4/3; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .score { position: absolute; right: 12px; top: 12px; }
  .smp { position: absolute; left: 12px; top: 12px; background: rgba(0,0,0,.6); color: #fff; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: .05em; }
  .bd { padding: 16px 18px 18px; }
  h3 { font-size: 25px; }
  .meta { margin-top: 6px; }
  p { font-size: 14.5px; margin-top: 10px; }
  a:hover h3 { color: var(--color-rose-dk); }
</style>
