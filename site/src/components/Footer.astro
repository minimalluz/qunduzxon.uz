---
import { SOCIAL, PHONE, PHONE_LABEL, EMAIL, TG_URL, TG_USER } from '../config';
import { NAV_L, SITE_L, UI, type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'uz' } = Astro.props;
const NAV = NAV_L[lang];
const SITE = SITE_L[lang];
const t = UI[lang];
const year = new Date().getFullYear();
const icons: Record<string, string> = {
  instagram: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2c-2.7 0-3 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 9 2 9.3 2 12s0 3 .1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1.1.1-1.4.1-4.1s0-3-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15 2 14.7 2 12 2z',
  telegram: 'M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.1 13 1.2 11.5c-1-.3-1.1-1 .2-1.5l19-7.3c.9-.3 1.7.2 1.5 1.6z',
  youtube: 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.4-1.6.5-3.2.5-4.8s-.1-3.2-.5-4.8zM9.7 15V9l5.8 3z',
  facebook: 'M14 8V6c0-.8.2-1.3 1.4-1.3H17V1.2C16.6 1.1 15.4 1 14 1c-2.9 0-4.9 1.8-4.9 5V8H6v4h3.1v11H14V12h3l.5-4z',
};
const names: Record<string, string> = { instagram: 'Instagram', telegram: 'Telegram', youtube: 'YouTube', facebook: 'Facebook' };
---
<footer class="ftr">
  <div class="wrap">
    <div class="fgrid">
      <div>
        {lang === 'ru'
          ? <a class="flogo" href="/ru/">Кундузхон <i>Абдуллаева</i></a>
          : <a class="flogo" href="/uz/">Қундузхон <i>Абдуллаева</i></a>}
        <p class="bio">{SITE.roles[0]}, {SITE.roles[1].toLowerCase()} {t.and} {SITE.roles[2].toLowerCase()}.</p>
        <div class="soc">
          {Object.entries(SOCIAL).map(([k, href]) => (
            <a href={href || '#'} aria-label={names[k]} target={href ? '_blank' : undefined} rel="noopener" data-empty={href ? undefined : ''}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[k]} /></svg>
            </a>
          ))}
        </div>
      </div>
      <div>
        <h4>{t.sections}</h4>
        <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>{t.contact}</h4>
        <ul>
          <li>{PHONE ? <a href={`tel:${PHONE}`}>{PHONE_LABEL}</a> : PHONE_LABEL}</li>
          <li><a href={TG_URL} target="_blank" rel="noopener">{TG_USER ? `@${TG_USER}` : 'Telegram'}</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>
      </div>
    </div>
    <div class="copy"><span>© {year} {SITE.name}</span><a href={`/${lang}/privacy-policy/`}>{t.privacy}</a></div>
  </div>
</footer>

<style>
  .ftr { background: var(--color-onair); color: rgba(255,255,255,.75); padding: 48px 0 28px; font-size: 14px; border-top: 1px solid rgba(255,255,255,.06); }
  .fgrid { display: grid; gap: 28px; }
  @media (min-width: 860px) { .fgrid { grid-template-columns: 1.4fr 1fr 1fr; } }
  .flogo { font-family: var(--font-serif); font-weight: 700; font-size: 24px; color: #fff; }
  .flogo i { color: var(--color-rose-lt); font-weight: 600; }
  .bio { margin-top: 10px; max-width: 40ch; }
  h4 { color: #fff; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 10px; font-weight: 600; }
  ul { display: grid; gap: 6px; }
  a:hover { color: #fff; }
  .soc { display: flex; gap: 10px; margin-top: 14px; }
  .soc a { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); display: grid; place-items: center; }
  .soc a[data-empty] { opacity: .35; }
  .soc svg { width: 18px; height: 18px; fill: #fff; }
  .copy { margin-top: 32px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.08); font-size: 12.5px; display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: space-between; }
</style>
