---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import VideoCard from './VideoCard.astro';
import LeadForm from './LeadForm.astro';
import { SITE as SITE_UZ, TG_URL, videoUrl } from '../config';
import { SITE_L, type Lang } from '../i18n';

export interface Video { file: string; poster: ImageMetadata; title: string; tag?: string }
interface Props {
  lang?: Lang;
  slug: string;
  title: string;
  titleHtml: string;
  serviceType: string;
  description: string;
  image: ImageMetadata;
  intro: string[];
  features: { t: string; d: string }[];
  videos: Video[];
  gallery?: ImageMetadata[];
  steps: { t: string; d: string }[];
  faq: { q: string; a: string }[];
  direction: string;
  testimonialsNote?: boolean;
}
const p = Astro.props;
const lang = p.lang ?? 'uz';
const SITE = { ...SITE_L[lang], url: SITE_UZ.url };
const T = {
  uz: {
    crumb: 'Бошловчи', country: 'Ўзбекистон', eyebrow: 'Бошловчилик хизматлари', book: 'Санани банд қилиш',
    video: 'Видео', videoH: 'Тадбирлардан лавҳалар', gallery: 'Фотогалерея', how: 'Қандай ишлаймиз', steps: 'Ишлаш босқичлари',
    fb: 'Фикрлар', fbH: 'Тўй эгаларининг фикрлари', fbNote: 'Отзивлар (исм, сана, қисқа фикр, расм) келгач шу ерда кўрсатилади.',
    faq: 'Саволлар', faqH: 'Кўп бериладиган саволлар', booking: 'Банд қилиш', check: 'Санани текширинг',
    lead: 'Сана ва телефон рақамингизни қолдиринг — тез орада боғланамиз.',
  },
  ru: {
    crumb: 'Ведущая', country: 'Узбекистан', eyebrow: 'Услуги ведущей', book: 'Забронировать дату',
    video: 'Видео', videoH: 'Фрагменты с мероприятий', gallery: 'Фотогалерея', how: 'Как мы работаем', steps: 'Этапы работы',
    fb: 'Отзывы', fbH: 'Отзывы хозяев торжеств', fbNote: 'Отзывы (имя, дата, короткий отзыв, фото) появятся здесь, когда будут присланы.',
    faq: 'Вопросы', faqH: 'Частые вопросы', booking: 'Бронирование', check: 'Проверьте дату',
    lead: 'Оставьте дату и номер телефона — мы скоро свяжемся с вами.',
  },
}[lang];
const crumbs = [{ href: `/${lang}/boshlovchi/`, label: T.crumb }, { href: `/${lang}/boshlovchi/${p.slug}/`, label: p.title }];
const url = new URL(`/${lang}/boshlovchi/${p.slug}/`, SITE.url).href;
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: p.title, serviceType: p.serviceType, description: p.description, url,
    areaServed: { '@type': 'Country', name: T.country },
    provider: { '@type': 'Person', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  ...p.videos.map((v) => ({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: v.title, description: `${v.title} — ${SITE.name}`,
    contentUrl: videoUrl(v.file), thumbnailUrl: new URL(v.poster.src, SITE.url).href, uploadDate: '2026-01-01',
  })),
];
---
<Base lang={lang} title={p.title} description={p.description} image={p.image} crumbs={crumbs} jsonLd={ld}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.eyebrow} lead={p.description}>
    <Fragment set:html={p.titleHtml} />
    <div slot="after" class="hcta"><a class="btn btn-rose" href={TG_URL} target="_blank" rel="noopener">{T.book}</a></div>
  </PageHero>

  <section class="sec">
    <div class="wrap two">
      <div class="prose-q">{p.intro.map((t) => <p>{t}</p>)}</div>
      <Image src={p.image} alt={p.title} widths={[480, 800]} sizes="(min-width:860px) 40vw, 100vw" class="side" />
    </div>
    <div class="wrap feats">
      {p.features.map((f) => <div class="feat"><h3>{f.t}</h3><p>{f.d}</p></div>)}
    </div>
  </section>

  {p.videos.length > 0 && (
    <section class="sec onair">
      <div class="wrap">
        <p class="eyebrow">{T.video}</p>
        <h2>{T.videoH}</h2>
        <div class="rail">{p.videos.map((v) => <VideoCard {...v} lang={lang} />)}</div>
      </div>
    </section>
  )}

  {p.gallery && p.gallery.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">{T.gallery}</p>
        <div class="gal">{p.gallery.map((g) => <Image src={g} alt="" widths={[360, 600]} sizes="(min-width:720px) 25vw, 50vw" loading="lazy" />)}</div>
      </div>
    </section>
  )}

  <section class="sec" style="background:#fff">
    <div class="wrap">
      <p class="eyebrow">{T.how}</p>
      <h2>{T.steps}</h2>
      <ol class="steps" style="margin-top:28px">{p.steps.map((s) => <li><b>{s.t}</b>{s.d}</li>)}</ol>
    </div>
  </section>

  {p.testimonialsNote && (
    <section class="sec" style="padding-bottom:0">
      <div class="wrap">
        <p class="eyebrow">{T.fb}</p>
        <h2>{T.fbH}</h2>
        <p class="placeholder" style="margin-top:20px">{T.fbNote}</p>
      </div>
    </section>
  )}

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">{T.faq}</p>
      <h2>{T.faqH}</h2>
      <div class="faq" style="margin-top:20px">
        {p.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="sec onair">
    <div class="wrap">
      <p class="eyebrow">{T.booking}</p>
      <h2>{T.check}</h2>
      <p class="lead">{T.lead}</p>
      <LeadForm lang={lang} direction={p.direction} />
    </div>
  </section>
</Base>

<style>
  .hcta { margin-top: 24px; }
  .two { display: grid; gap: 32px; align-items: center; }
  .two :global(.side) { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--r); }
  @media (min-width: 860px) { .two { grid-template-columns: 1.15fr .85fr; gap: 56px; } }
  .feats { display: grid; gap: 14px; margin-top: 40px; }
  .feat { padding: 22px; border-radius: var(--r); background: #fff; box-shadow: 0 1px 0 var(--color-line); }
  .feat h3 { font-size: 24px; } .feat p { color: var(--color-muted); margin-top: 6px; font-size: 15px; }
  @media (min-width: 720px) { .feats { grid-template-columns: repeat(3, 1fr); } }
  .gal { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 20px; }
  .gal :global(img) { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 14px; }
  @media (min-width: 720px) { .gal { grid-template-columns: repeat(4, 1fr); } }
</style>
