---
// Админ панел: qunduzxon.uz/admin/
// Маълумот functions/api/admin/* орқали GitHub'даги src/data/settings.json га ёзилади.
import '@fontsource/cormorant-garamond/700.css';
import { TURNSTILE_SITE_KEY } from '../config';

const fields = {
  contact: [
    { name: 'telegram', label: 'Telegram username', type: 'text', placeholder: 'qunduzxon', hint: '@ белгисиз ёзинг. Сайтдаги «Банд қилиш» ва «Telegram» тугмалари шу чатга олиб боради.' },
    { name: 'phone', label: 'Телефон рақами', type: 'tel', placeholder: '+998 90 123 45 67', hint: 'Бўш бўлса, «Қўнғироқ» тугмаси кўринмайди.' },
    { name: 'email', label: 'Email', type: 'email', placeholder: 'info@qunduzxon.uz', hint: '' },
  ],
  social: [
    { name: 'instagram', label: 'Instagram', type: 'url', placeholder: 'https://www.instagram.com/...', hint: '' },
    { name: 'facebook', label: 'Facebook', type: 'url', placeholder: 'https://www.facebook.com/...', hint: '' },
    { name: 'youtube', label: 'YouTube', type: 'url', placeholder: 'https://www.youtube.com/@...', hint: 'Бўш қолган тармоқнинг белгиси сайтда хира кўринади.' },
  ],
  stats: [
    { name: 'years', label: 'Эфирда неча йил', placeholder: '16', hint: '' },
    { name: 'events', label: 'Тадбирлар сони (тахминан)', placeholder: '1000', hint: '' },
    { name: 'followers', label: 'Обуначилар (мингда)', placeholder: '500', hint: '500 деб ёзилса, сайтда «500 минг+» чиқади.' },
  ],
};
---
<!doctype html>
<html lang="uz-Cyrl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Админ панел — Қундузхон Абдуллаева</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
  <header class="top">
    <div class="in">
      <span class="brand">Қундузхон <i>Абдуллаева</i> <small>админ панел</small></span>
      <nav>
        <a href="/uz/" target="_blank" rel="noopener">Сайтни очиш ↗</a>
        <button type="button" id="logout" hidden>Чиқиш</button>
      </nav>
    </div>
  </header>

  <main class="in">
    <p id="loading" class="muted">Юкланмоқда…</p>

    <!-- Кириш -->
    <section id="login" class="card login" hidden>
      <h1>Админ панелга кириш</h1>
      <form id="login-form" novalidate>
        <label class="field">
          <span>Парол</span>
          <div class="pw">
            <input type="password" name="password" autocomplete="current-password" required autofocus />
            <button type="button" class="eye" aria-label="Паролни кўрсатиш">👁</button>
          </div>
        </label>
        {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>}
        <button class="btn" type="submit">Кириш</button>
        <p class="msg" id="login-msg" role="alert"></p>
      </form>
    </section>

    <!-- Созламалар -->
    <form id="settings" hidden novalidate>
      <h1>Сайт созламалари</h1>
      <p class="muted lead">Ўзгартиринг ва пастдаги <b>«Сақлаш»</b> тугмасини босинг. Сайт 2–3 дақиқада ўзи янгиланади.</p>

      <section class="card">
        <h2>Алоқа</h2>
        {fields.contact.map((f) => (
          <label class="field">
            <span>{f.label}</span>
            <input name={f.name} type={f.type} placeholder={f.placeholder} autocomplete="off" />
            {f.hint && <small>{f.hint}</small>}
            <em class="err" data-err={f.name}></em>
          </label>
        ))}
      </section>

      <section class="card">
        <h2>Ижтимоий тармоқлар</h2>
        {fields.social.map((f) => (
          <label class="field">
            <span>{f.label}</span>
            <input name={f.name} type={f.type} placeholder={f.placeholder} autocomplete="off" />
            {f.hint && <small>{f.hint}</small>}
            <em class="err" data-err={f.name}></em>
          </label>
        ))}
      </section>

      <section class="card">
        <h2>Сайтдаги рақамлар</h2>
        <div class="grid3">
          {fields.stats.map((f) => (
            <label class="field">
              <span>{f.label}</span>
              <input name={f.name} type="number" inputmode="numeric" min="0" step="1" placeholder={f.placeholder} />
              {f.hint && <small>{f.hint}</small>}
              <em class="err" data-err={f.name}></em>
            </label>
          ))}
        </div>
      </section>

      <section class="card">
        <h2>Сайт бўлимлари</h2>
        <label class="switch">
          <input type="checkbox" name="showDateCheck" />
          <span class="track" aria-hidden="true"><span></span></span>
          <span class="txt">
            <b>«Бўш санани текшириш» формаси</b>
            <small>Бош саҳифадаги «Тадбирингиз қачон?» ва хизмат саҳифаларидаги «Санани текширинг» формалари. Ёқилса — сайтда кўринади.</small>
          </span>
        </label>
      </section>

      <div class="bar">
        <p class="msg" id="save-msg" role="status" aria-live="polite"></p>
        <button class="btn" type="submit" id="save" disabled>Сақлаш</button>
      </div>
    </form>

    <section id="error" class="card" hidden>
      <h1>Админ панел ишламаяпти</h1>
      <p id="error-text"></p>
    </section>
  </main>
</body>
</html>

<style is:global>
  :root { --ink: #2A1B24; --muted: #6E5A65; --rose: #D63C7A; --rose-dk: #B52A63; --rose-lt: #F49BBE; --bg: #FBF7F4; --line: #EADFE3; --onair: #1C1218; --ok: #1F7A4D; --bad: #B3261E; }
  * { box-sizing: border-box; margin: 0; }
  body { background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; padding-bottom: 96px; }
  [hidden] { display: none !important; }
  .in { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .top { background: var(--onair); color: #fff; }
  .top .in { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; flex-wrap: wrap; }
  .brand { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 700; font-size: 22px; }
  .brand i { color: var(--rose-lt); }
  .brand small { font-family: system-ui, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; opacity: .6; margin-left: 6px; }
  .top nav { display: flex; gap: 8px; align-items: center; }
  .top nav a, .top nav button { color: #fff; background: rgba(255,255,255,.1); border: 0; border-radius: 999px; padding: 8px 14px; font: 600 14px system-ui, sans-serif; text-decoration: none; cursor: pointer; }
  main { padding-top: 28px; }
  h1 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 36px; line-height: 1.1; }
  h2 { font-size: 15px; letter-spacing: .1em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; }
  .lead { margin: 8px 0 20px; }
  .muted { color: var(--muted); }
  .card { background: #fff; border-radius: 18px; padding: 22px; box-shadow: 0 1px 0 var(--line); margin-bottom: 16px; }
  .login { max-width: 420px; margin: 40px auto; }
  .login h1 { margin-bottom: 18px; }
  .field { display: grid; gap: 6px; margin-bottom: 16px; }
  .field > span { font-weight: 600; }
  .field small { color: var(--muted); font-size: 13.5px; }
  input[type=text], input[type=tel], input[type=email], input[type=url], input[type=number], input[type=password] {
    width: 100%; min-height: 48px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 14px; font: 16px system-ui, sans-serif; background: #fff; color: var(--ink);
  }
  input:focus { outline: none; border-color: var(--rose); box-shadow: 0 0 0 3px rgba(214,60,122,.15); }
  .field.bad input { border-color: var(--bad); }
  .err { color: var(--bad); font-style: normal; font-size: 13.5px; }
  .err:empty { display: none; }
  .grid3 { display: grid; gap: 0 14px; }
  @media (min-width: 640px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
  .pw { position: relative; }
  .pw input { padding-right: 52px; }
  .eye { position: absolute; right: 4px; top: 4px; width: 40px; height: 40px; border: 0; background: none; font-size: 18px; cursor: pointer; }
  .btn { min-height: 48px; padding: 0 26px; border: 0; border-radius: 999px; background: var(--rose); color: #fff; font: 600 16px system-ui, sans-serif; cursor: pointer; }
  .btn:hover { background: var(--rose-dk); }
  .btn:disabled { background: #cdbcc4; cursor: default; }
  .login .btn { width: 100%; margin-top: 4px; }
  .cf-turnstile { margin-bottom: 12px; }
  .msg { font-size: 14.5px; margin-top: 10px; }
  .msg.ok { color: var(--ok); } .msg.bad { color: var(--bad); }
  .switch { display: flex; gap: 14px; align-items: flex-start; cursor: pointer; }
  .switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .track { flex: none; width: 52px; height: 30px; border-radius: 999px; background: #d9cdd3; position: relative; transition: background .2s; margin-top: 2px; }
  .track span { position: absolute; left: 3px; top: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: transform .2s; }
  .switch input:checked + .track { background: var(--ok); }
  .switch input:checked + .track span { transform: translateX(22px); }
  .switch input:focus-visible + .track { box-shadow: 0 0 0 3px rgba(214,60,122,.3); }
  .switch .txt { display: grid; gap: 4px; } .switch small { color: var(--muted); font-size: 13.5px; }
  .bar { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.96); border-top: 1px solid var(--line); padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; gap: 16px; }
  .bar .msg { margin: 0; flex: 1; max-width: 520px; }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const loading = $('loading'), login = $('login'), form = $<HTMLFormElement>('settings'), errBox = $('error');
  const saveBtn = $<HTMLButtonElement>('save'), saveMsg = $('save-msg'), logoutBtn = $<HTMLButtonElement>('logout');
  const NUM = ['years', 'events', 'followers'];
  let sha = '';
  let saved = '';

  const show = (el: HTMLElement | null) => {
    [loading, login, form, errBox].forEach((x) => (x.hidden = x !== el));
    logoutBtn.hidden = el !== form;
  };
  const fail = (text: string) => { $('error-text').textContent = text; show(errBox); };
  const MESSAGES: Record<string, string> = {
    not_configured: 'Cloudflare\'да ADMIN_PASSWORD (камида 12 белги) ва GITHUB_TOKEN созланмаган. Йўриқнома: site/README.md → «Админ панел».',
    github: 'GitHub билан боғланишда хато. GITHUB_TOKEN нинг муддати ва ҳуқуқларини текширинг.',
  };

  const api = async (method: string, path: string, body?: unknown) => {
    const r = await fetch(`/api/admin/${path}`, {
      method,
      credentials: 'same-origin',
      headers: body ? { 'content-type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined,
    });
    let data: any = {};
    try { data = await r.json(); } catch { /* бўш жавоб */ }
    return { status: r.status, data };
  };

  // Формани тўлдириш ва ўқиш
  const fill = (s: Record<string, unknown>) => {
    for (const el of Array.from(form.elements) as HTMLInputElement[]) {
      if (!el.name) continue;
      if (el.type === 'checkbox') el.checked = s[el.name] === true;
      else el.value = s[el.name] == null ? '' : String(s[el.name]);
    }
    saved = JSON.stringify(read());
    saveBtn.disabled = true;
  };
  const read = () => {
    const out: Record<string, unknown> = {};
    for (const el of Array.from(form.elements) as HTMLInputElement[]) {
      if (!el.name) continue;
      out[el.name] = el.type === 'checkbox' ? el.checked : NUM.includes(el.name) ? (el.value === '' ? '' : Number(el.value)) : el.value.trim();
    }
    return out;
  };
  const dirty = () => JSON.stringify(read()) !== saved;
  const clearErrors = () => form.querySelectorAll<HTMLElement>('[data-err]').forEach((e) => { e.textContent = ''; e.closest('.field')?.classList.remove('bad'); });

  form.addEventListener('input', () => {
    saveBtn.disabled = !dirty();
    if (!saveBtn.disabled) { saveMsg.textContent = 'Сақланмаган ўзгаришлар бор.'; saveMsg.className = 'msg'; }
    else saveMsg.textContent = '';
  });
  addEventListener('beforeunload', (e) => { if (!form.hidden && dirty()) e.preventDefault(); });

  async function load() {
    show(loading);
    const { status, data } = await api('GET', 'settings');
    if (status === 200 && data.ok) { sha = data.sha; fill(data.settings); show(form); return; }
    if (status === 401) { show(login); (login.querySelector('input[name=password]') as HTMLInputElement).focus(); return; }
    fail(MESSAGES[data.error] ?? `Хато (${status}). Бироздан кейин қайта уриниб кўринг.`);
  }

  // Кириш
  const loginForm = $<HTMLFormElement>('login-form');
  const loginMsg = $('login-msg');
  loginForm.querySelector('.eye')!.addEventListener('click', () => {
    const i = loginForm.querySelector('input[name=password]') as HTMLInputElement;
    i.type = i.type === 'password' ? 'text' : 'password';
  });
  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = loginForm.querySelector('button[type=submit]') as HTMLButtonElement;
    loginMsg.className = 'msg'; loginMsg.textContent = 'Текширилмоқда…';
    btn.disabled = true;
    const fd = Object.fromEntries(new FormData(loginForm));
    const { status, data } = await api('POST', 'login', fd);
    btn.disabled = false;
    if (status === 200 && data.ok) { loginForm.reset(); loginMsg.textContent = ''; load(); return; }
    loginMsg.className = 'msg bad';
    loginMsg.textContent = data.error === 'password' ? 'Парол нотўғри.' : data.error === 'captcha' ? 'Текширувдан ўтинг («Я не робот»).' : MESSAGES[data.error] ?? `Хато (${status}).`;
    (window as any).turnstile?.reset?.();
  });

  // Сақлаш
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    saveBtn.disabled = true;
    saveMsg.className = 'msg'; saveMsg.textContent = 'Сақланмоқда…';
    const { status, data } = await api('PUT', 'settings', { settings: read(), sha });
    if (status === 200 && data.ok) {
      sha = data.sha; fill(data.settings);
      saveMsg.className = 'msg ok';
      saveMsg.textContent = '✓ Сақланди! Сайт 2–3 дақиқада янгиланади.';
      return;
    }
    saveBtn.disabled = false;
    saveMsg.className = 'msg bad';
    if (status === 401) { saveMsg.textContent = ''; show(login); return; }
    if (data.error === 'invalid') {
      for (const [k, v] of Object.entries(data.errors as Record<string, string>)) {
        const el = form.querySelector<HTMLElement>(`[data-err="${k}"]`);
        if (el) { el.textContent = v; el.closest('.field')?.classList.add('bad'); }
      }
      saveMsg.textContent = 'Қизил билан белгиланган майдонларни тўғриланг.';
      form.querySelector<HTMLElement>('.field.bad input')?.focus();
      return;
    }
    if (data.error === 'conflict') { saveMsg.textContent = 'Созламалар бошқа жойда ўзгартирилган. Саҳифани янгиланг (F5) ва қайта сақланг.'; return; }
    saveMsg.textContent = MESSAGES[data.error] ?? `Сақлаб бўлмади (${status}). Қайта уриниб кўринг.`;
  });

  logoutBtn.addEventListener('click', async () => {
    if (dirty() && !confirm('Сақланмаган ўзгаришлар бор. Барибир чиқасизми?')) return;
    await api('POST', 'logout');
    show(login);
  });

  load();
</script>
