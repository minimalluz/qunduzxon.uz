---
import ServicePage from '../../../components/ServicePage.astro';
import blazer from '../../../assets/photos/blazer.jpg';
import yangiHayot from '../../../assets/photos/yangi-hayot.jpg';
import blackRed from '../../../assets/photos/black-red.jpg';
import teal from '../../../assets/photos/teal-dress.jpg';
import greenGown from '../../../assets/photos/green-gown.jpg';
---
<ServicePage
  lang="ru"
  slug="korporativ-tadbirlar"
  title="Корпоративные мероприятия и презентации"
  titleHtml="Корпоративные мероприятия и <em>презентации</em>"
  serviceType="Ведущая корпоративных мероприятий"
  description="Профессиональное ведение бизнес-форумов, открытий брендов, презентаций, мероприятий государственных и частных компаний."
  image={blazer}
  intro={[
    'На корпоративном мероприятии ведущая — это голос, который объединяет бренд, организацию и гостей.',
    'Веду форумы, конференции, открытия брендов и магазинов, ежегодные вечера и презентации — в официальном и живом стиле.',
  ]}
  features={[
    { t: 'Бизнес-форумы', d: 'Официальный протокол, спикеры и панельные дискуссии.' },
    { t: 'Открытия брендов', d: 'Открытия ресторанов, магазинов и брендов — с освещением в медиа.' },
    { t: 'Презентации', d: 'Презентации продуктов и проектов, ежегодные вечера.' },
  ]}
  videos={[
    { file: 'islom-sivilizatsiyasi-markazi.mp4', poster: blackRed, title: 'Центр исламской цивилизации', tag: 'Мероприятие' },
    { file: 'yangi-hayot-studiyasi.mp4', poster: yangiHayot, title: 'В студии «Янги хаёт»', tag: 'ТВ' },
  ]}
  gallery={[blazer, teal, greenGown, yangiHayot]}
  steps={[
    { t: 'Бриф', d: 'Получаем информацию о цели мероприятия, аудитории и программе.' },
    { t: 'Сценарий', d: 'Готовятся протокол, порядок выступления спикеров и тексты.' },
    { t: 'Репетиция', d: 'При необходимости — проверка техники и тайминга на площадке.' },
    { t: 'Мероприятие', d: 'Мероприятие проходит по плану, вовремя и на высоком уровне.' },
  ]}
  faq={[
    { q: 'На каких языках вы ведёте?', a: 'На узбекском и русском языках.' },
    { q: 'Можно ли осветить открытие в медиа?', a: 'Да, есть комбо-пакет «Открытие + освещение в медиа» — подробнее на странице «Сотрудничество».' },
    { q: 'Кто пишет сценарий?', a: 'Сценарий готовится по согласованию с заказчиком.' },
  ]}
  direction="korporativ"
/>
