---
import ServicePage from '../../../components/ServicePage.astro';
import toy from '../../../assets/photos/toy.jpg';
import national from '../../../assets/photos/national.jpg';
import greenGown from '../../../assets/photos/green-gown.jpg';
import teal from '../../../assets/photos/teal-dress.jpg';
import eventGreen from '../../../assets/photos/event-green.jpg';
import nightRoses from '../../../assets/photos/night-roses.jpg';
import flowers from '../../../assets/photos/flowers.jpg';
---
<ServicePage
  lang="ru"
  slug="toy-va-tantanalar"
  title="Ведущая свадеб и торжеств"
  titleHtml="Ведущая свадеб и <em>торжеств</em>"
  serviceType="Ведущая свадеб и торжеств"
  description="Свадьбы, никах, юбилеи и семейные торжества в национальном и современном стиле, на узбекском и русском языках."
  image={toy}
  intro={[
    'Свадьба — самый яркий день для семьи. Задача ведущей — чтобы этот день прошёл слаженно, искренне и незабываемо.',
    'Веду торжества в современном стиле, с уважением к национальным обычаям. При необходимости торжество можно провести на узбекском и русском языках.',
  ]}
  features={[
    { t: 'Национально и современно', d: 'Сочетание традиционных обрядов и элементов современного шоу.' },
    { t: 'На двух языках', d: 'На узбекском и русском — понятно всем гостям.' },
    { t: 'Подготовка', d: 'Сценарий, порядок программы и поздравления согласуются заранее.' },
  ]}
  videos={[
    { file: 'toyga-ham-ulgurdim.mp4', poster: national, title: 'Успела и на свадьбу', tag: 'Свадьба' },
    { file: 'oq-libos.mp4', poster: greenGown, title: 'Белое платье', tag: 'Свадьба' },
    { file: 'qizil-gilamda.mp4', poster: eventGreen, title: 'На красной дорожке', tag: 'Сцена' },
    { file: 'sevgi-haqida.mp4', poster: nightRoses, title: 'О любви', tag: 'Фрагмент' },
  ]}
  gallery={[toy, teal, greenGown, flowers]}
  steps={[
    { t: 'Обращение', d: 'Вы пишете в Telegram или через форму о дате и мероприятии.' },
    { t: 'Встреча', d: 'Обсуждаем настроение торжества, гостей и программу.' },
    { t: 'Сценарий', d: 'Выстраиваются порядок программы, поздравления и музыка.' },
    { t: 'День торжества', d: 'Мероприятие проходит слаженно от начала до конца.' },
  ]}
  faq={[
    { q: 'За сколько времени нужно бронировать?', a: 'В свадебный сезон даты быстро занимают, поэтому советуем написать как можно раньше.' },
    { q: 'Вы ведёте торжество на двух языках?', a: 'Да, при необходимости мероприятие проводится на узбекском и русском языках.' },
    { q: 'Кто готовит сценарий?', a: 'Сценарий готовится вместе с вами, с учётом пожеланий вашей семьи.' },
    { q: 'Сколько это стоит?', a: 'Стоимость зависит от даты, места и продолжительности мероприятия. Точную цену уточняйте в Telegram.' },
  ]}
  direction="toy"
  testimonialsNote
/>
