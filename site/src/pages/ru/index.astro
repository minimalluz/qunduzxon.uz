---
// Русская версия: пока только главная-заглушка. Полный перевод страниц — следующий этап.
import Base from '../../layouts/Base.astro';
import { TG_URL } from '../../config';
---
<Base title="Кундузхон Абдуллаева — теле- и радиоведущая, ведущая торжеств, фуд-блогер"description="Кундузхон Абдуллаева — теле- и радиоведущая, ведущая торжеств и фуд-блогер. Бронирование даты и сотрудничество." lang="ru" ruHref="/ru/">
  <section class="page-hero" style="min-height:80svh;display:flex;align-items:center">
    <div class="wrap">
      <p class="eyebrow">Официальный сайт</p>
      <h1>Кундузхон <em>Абдуллаева</em></h1>
      <p class="lead">Теле- и радиоведущая, ведущая свадеб и торжеств, фуд-блогер. Русская версия сайта скоро будет готова.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:26px">
        <a class="btn btn-rose" href={TG_URL} target="_blank" rel="noopener">Забронировать дату</a>
        <a class="btn btn-ghost" href="/uz/" hreflang="uz">Сайт на узбекском</a>
      </div>
    </div>
  </section>
</Base>
