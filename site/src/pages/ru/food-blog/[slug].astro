---
import ReviewView from '../../../views/Review.astro';
import { allReviews, type Review } from '../../../lib/reviews';

export async function getStaticPaths() {
  const reviews = await allReviews('ru');
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review, reviews } }));
}
interface Props { review: Review; reviews: Review[] }
const { review, reviews } = Astro.props;
---
<ReviewView lang="ru" review={review} reviews={reviews} />
