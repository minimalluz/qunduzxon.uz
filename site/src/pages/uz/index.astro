---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE, STATS, TG_URL, videoUrl, SOCIAL } from '../../config';
import { allReviews } from '../../lib/reviews';
import hero from '../../assets/photos/hero.jpg';
import toy from '../../assets/photos/toy.jpg';
import radio from '../../assets/photos/radio.jpg';
import food from '../../assets/photos/food.jpg';
import mic from '../../assets/photos/mic.jpg';
import green from '../../assets/photos/green.jpg';
import national from '../../assets/photos/national.jpg';
import orange from '../../assets/photos/orange.jpg';
import ona1 from '../../assets/ona/ona-1.jpg';
import ona2 from '../../assets/ona/ona-2.jpg';
import ona3 from '../../assets/ona/ona-3.jpg';

const reviews = (await allReviews()).slice(0, 3);
const poster = await getImage({ src: hero, width: 960, format: 'webp', quality: 70 });

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  image: new URL(poster.src, SITE.url).href,
  jobTitle: SITE.roles,
  sameAs: Object.values(SOCIAL).filter((u) => u && u !== 'https://t.me/'),
};
const partners = ['Hit FM', '90.8 FM', 'Янги ҳаёт', 'Marina'];
const demos = [
  { t: 'Тўй / лирик', d: '0:25' },
  { t: 'Расмий ТВ', d: '0:20' },
  { t: 'Драйв радио', d: '0:15' },
  { t: 'Реклама', d: '0:30' },
];
---
<Base title={SITE.name} jsonLd={[person]} ruHref="/ru/">
  <link slot="head" rel="preload" as="image" href={poster.src} fetchpriority="high" />

  <!-- HERO -->
  <section class="hero">
    <Image class="poster" src={hero} alt="Қундузхон Абдуллаева радио студиясида" widths={[480, 960]} sizes="(min-width:1000px) 440px, 100vw" loading="eager" fetchpriority="high" />
    <video id="reel" muted loop playsinline preload="none" poster={poster.src} aria-label="Шоурил">
      <source src={videoUrl('showreel.mp4')} type="video/mp4" />
    </video>
    <button class="sound" id="sound" type="button" aria-pressed="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" /><path id="wave" d="m17 9 4 6m0-6-4 6" /></svg>
      <span>Овозни ёқиш</span>
    </button>
    <div class="wrap">
      <div class="txt">
        <p class="eyebrow" style="color:var(--color-rose-lt)">Расмий сайт</p>
        <h1>Қундузхон<em>Абдуллаева</em></h1>
        <div class="roles">{SITE.roles.map((r) => <span>{r}</span>)}</div>
        <div class="cta">
          <a class="btn btn-rose" href={TG_URL} target="_blank" rel="noopener">Тадбир учун банд қилиш</a>
          <a class="btn btn-ghost" href="/uz/hamkorlik/">Реклама / Фуд-блог</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECTIONS -->
  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">Йўналишлар</p>
      <h2>Саҳнада, эфирда ва дастурхон устида</h2>
      <div class="dirs">
        <a class="dir" href="/uz/boshlovchi/toy-va-tantanalar/">
          <Image src={toy} alt="Тантана бошловчиси" widths={[480, 800]} sizes="(min-width:720px) 33vw, 100vw" loading="lazy" />
          <div><h3>Тўй ва тантаналар</h3><p>Миллий ва замонавий услубда, икки тилда</p><span class="go">Батафсил →</span></div>
        </a>
        <a class="dir" href="/uz/boshlovchi/tv-radio-ovoz/">
          <Image src={radio} alt="Радио эфирида" widths={[480, 800]} sizes="(min-width:720px) 33vw, 100vw" loading="lazy" />
          <div><h3>ТВ, радио ва корпоратив</h3><p>Эфир, дикторлик, форум ва тақдимотлар</p><span class="go">Батафсил →</span></div>
        </a>
        <a class="dir food" href="/uz/food-blog/">
          <Image src={food} alt="Ресторанда" widths={[480, 800]} sizes="(min-width:720px) 33vw, 100vw" loading="lazy" />
          <div><h3>Фуд-блог</h3><p>Ресторан шарҳлари ва гастро-гид</p><span class="go">Шарҳларни кўриш →</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- STATS + AUDIO -->
  <section class="sec onair">
    <div class="wrap">
      <div class="stats">
        {STATS.map((s) => <div class="stat"><b data-n={s.n} data-s={s.suffix}>{s.n}{s.suffix && <small>{s.suffix}</small>}</b><span>{s.label}</span></div>)}
      </div>
      <div style="margin-top:72px">
        <p class="eyebrow">Аудио-визитка</p>
        <h2>Овозимни тингланг</h2>
        <div class="audio-grid">
          {demos.map((d) => (
            <div class="track"><button disabled type="button" aria-label={`Ижро этиш: ${d.t}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></button><div><b>{d.t}</b><small>{d.d}</small></div><div class="bars" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i style={`height:${6 + ((i * 37) % 22)}px`}></i>)}</div></div>
          ))}
        </div>
        <p class="note" style="color:rgba(255,255,255,.5)">Аудио демолар ҳали йўқ — файллар келганда плеер ишлайди.</p>
      </div>
    </div>
  </section>

  <!-- VIDEO CASES -->
  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">Видео-кейслар</p>
      <h2>Эфир ва саҳнадан лавҳалар</h2>
      <div class="rail">
        <VideoCard file="hit-fm-efirida.mp4" poster={mic} title="Hit FM эфирида" tag="Радио" />
        <VideoCard file="qizil-gilamda.mp4" poster={green} title="Қизил гиламда" tag="Саҳна" />
        <VideoCard file="toyga-ham-ulgurdim.mp4" poster={national} title="Тўйга ҳам улгурдим" tag="Тўй" />
        <VideoCard file="radio-studiyasida.mp4" poster={orange} title="Радио студиясида" tag="Студия" />
      </div>
      <a class="btn btn-line" href="/uz/media/" style="margin-top:28px">Барча видео ва расмлар</a>
    </div>
  </section>

  <!-- FOOD -->
  <section class="sec food-sec">
    <div class="wrap">
      <p class="eyebrow">Фуд-блог</p>
      <h2>Сўнгги шарҳлар</h2>
      <div class="fcards">{reviews.map((r) => <ReviewCard review={r} />)}</div>
      <a class="btn btn-line more" href="/uz/food-blog/">Барча шарҳларни кўриш</a>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="sec" style="padding-bottom:0">
    <div class="wrap">
      <p class="eyebrow">Ҳамкорлар</p>
      <div class="partners">{partners.map((p) => <span>{p}</span>)}</div>
      <p class="note">Логотиплар келгач, номлар ўрнига логотиплар қўйилади.</p>
    </div>
  </section>

  <!-- MOTHER -->
  <section class="sec mom-sec">
    <div class="wrap mom">
      <div class="mom-pics">
        <Image src={ona1} alt="Онам билан" widths={[400, 700]} sizes="(min-width:860px) 25vw, 50vw" loading="lazy" />
        <Image src={ona2} alt="Онам билан" widths={[300, 500]} sizes="(min-width:860px) 20vw, 50vw" loading="lazy" />
        <Image src={ona3} alt="Онам билан" widths={[300, 500]} sizes="(min-width:860px) 20vw, 50vw" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Менинг онам</p>
        <h2>Ҳаётимдаги энг қимматли инсон</h2>
        <div class="values"><span>Меҳр</span><span>Дуо</span><span>Ҳурмат</span></div>
        <blockquote>«Она — бу дунёдаги энг муқаддас сўз, она меҳри — энг буюк неъмат.»</blockquote>
        <a class="btn btn-rose" href="/uz/onam/">Онам ҳақида</a>
      </div>
    </div>
  </section>

  <!-- DATE CHECK -->
  <section class="sec onair" id="sana">
    <div class="wrap">
      <p class="eyebrow">Бўш санани текшириш</p>
      <h2>Тадбирингиз қачон?</h2>
      <p class="lead">Сана ва телефон рақамингизни қолдиринг — тез орада боғланамиз.</p>
      <LeadForm />
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: #fff; background: var(--color-onair); overflow: hidden; }
  .hero :global(.poster), .hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; transition: opacity .4s; }
  .hero video { opacity: 0; }
  .hero.playing video { opacity: 1; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(28,18,24,.35) 0%, rgba(28,18,24,0) 30%, rgba(28,18,24,.55) 62%, rgba(28,18,24,.95) 100%); }
  .hero .wrap { position: relative; z-index: 2; padding-bottom: clamp(40px, 8vh, 88px); width: 100%; }
  .hero h1 { font-size: clamp(48px, 11vw, 96px); }
  .hero h1 em { display: block; font-style: italic; font-weight: 600; color: var(--color-rose-lt); }
  .roles { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 26px; }
  .roles span { font-size: 13px; padding: 6px 12px; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(255,255,255,.06); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .sound { position: absolute; z-index: 3; right: var(--pad); top: 80px; display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; background: rgba(0,0,0,.45); backdrop-filter: blur(6px); color: #fff; font-size: 13px; font-weight: 600; }
  .sound svg { width: 18px; height: 18px; }
  @media (min-width: 1000px) {
    .hero { align-items: center; background: radial-gradient(circle at 75% 40%, #3a2230, var(--color-onair) 60%); }
    .hero .wrap { padding-bottom: 0; }
    .hero .txt { max-width: 560px; }
    .hero :global(.poster), .hero video { left: auto; right: max(32px, calc((100vw - var(--max)) / 2 + 32px)); top: 50%; transform: translateY(-50%); width: auto; height: min(78vh, 760px); aspect-ratio: 9/16; border-radius: 24px; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
    .hero::after { background: linear-gradient(90deg, rgba(28,18,24,.6), transparent 50%); }
    .sound { top: auto; bottom: calc(50% - min(39vh, 380px) + 16px); right: max(48px, calc((100vw - var(--max)) / 2 + 48px)); }
  }

  .dirs { display: grid; gap: 14px; margin-top: 32px; }
  .dir { position: relative; border-radius: var(--r); overflow: hidden; aspect-ratio: 4/5; color: #fff; isolation: isolate; }
  .dir :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .dir:hover :global(img) { transform: scale(1.04); }
  .dir::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(28,18,24,.9)); }
  .dir div { position: absolute; inset: auto 0 0; padding: 22px; z-index: 1; }
  .dir h3 { font-size: 30px; }
  .dir p { font-size: 14px; opacity: .85; margin-top: 4px; }
  .go { display: inline-block; margin-top: 12px; font-size: 14px; font-weight: 600; border-bottom: 1.5px solid currentColor; }
  .dir.food .go { color: #FFC48A; }
  @media (min-width: 720px) { .dirs { grid-template-columns: repeat(3, 1fr); } }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center; }
  .stat b { display: block; font-family: var(--font-serif); font-weight: 700; font-size: clamp(38px, 9vw, 72px); color: var(--color-rose-lt); line-height: 1; white-space: nowrap; }
  .stat b :global(small) { font-size: .45em; font-weight: 600; margin-left: 2px; }
  .stat span { font-size: 13px; opacity: .75; display: block; margin-top: 8px; }

  .audio-grid { display: grid; gap: 12px; margin-top: 28px; }
  .track { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 14px; background: var(--color-onair-2); border: 1px solid rgba(255,255,255,.06); }
  .track button { flex: none; width: 48px; height: 48px; border-radius: 50%; background: #4a3a43; display: grid; place-items: center; cursor: not-allowed; }
  .track svg { width: 18px; height: 18px; fill: #fff; }
  .track b { display: block; font-size: 15px; } .track small { opacity: .6; font-size: 12.5px; }
  .bars { margin-left: auto; display: flex; gap: 3px; align-items: center; height: 28px; }
  .bars i { width: 3px; background: var(--color-rose-lt); opacity: .35; border-radius: 2px; }
  @media (min-width: 720px) { .audio-grid { grid-template-columns: 1fr 1fr; } }

  .fcards { display: grid; gap: 16px; margin-top: 28px; }
  @media (min-width: 720px) { .fcards { grid-template-columns: repeat(3, 1fr); } }
  .more { border-color: #C9650C; color: #9A4C08; margin-top: 28px; }

  .partners { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; margin-top: 22px; }
  .partners span { flex: none; padding: 14px 22px; border: 1px solid var(--color-line); border-radius: 12px; font-weight: 700; color: var(--color-muted); background: #fff; }

  .mom-sec { background: #FDF0F5; }
  .mom { display: grid; gap: 24px; align-items: center; }
  .mom-pics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mom-pics :global(img) { border-radius: 14px; aspect-ratio: 3/4; object-fit: cover; width: 100%; }
  .mom-pics :global(img:first-child) { grid-row: span 2; height: 100%; aspect-ratio: auto; }
  .values { display: flex; gap: 10px; margin: 18px 0; }
  .values span { padding: 8px 14px; border-radius: 999px; background: #F7E6EE; color: var(--color-mauve); font-weight: 600; font-size: 14px; }
  blockquote { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: clamp(23px, 3.8vw, 30px); line-height: 1.35; border-left: 3px solid var(--color-rose); padding-left: 16px; margin: 8px 0 22px; }
  @media (min-width: 860px) { .mom { grid-template-columns: 1fr 1.1fr; gap: 56px; } }
</style>

<script>
  // Hero видео: саҳифа юклангач, овозсиз бошланади
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const reel = document.getElementById('reel') as HTMLVideoElement;
  const sound = document.getElementById('sound')!;
  addEventListener('load', () => { reel.preload = 'auto'; reel.play().catch(() => {}); });
  reel.addEventListener('playing', () => hero.classList.add('playing'));
  sound.addEventListener('click', () => {
    reel.muted = !reel.muted;
    if (reel.paused) reel.play();
    sound.setAttribute('aria-pressed', String(!reel.muted));
    sound.querySelector('span')!.textContent = reel.muted ? 'Овозни ёқиш' : 'Овозни ўчириш';
    document.getElementById('wave')!.setAttribute('d', reel.muted ? 'm17 9 4 6m0-6-4 6' : 'M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13');
  });
  // Бошқа видео ўйнаса, шоурил тўхтайди
  document.addEventListener('play', (e) => { if (e.target !== reel) reel.pause(); }, true);

  // Рақамлар ҳисоблагичи
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    io.unobserve(e.target);
    const el = e.target as HTMLElement, n = +el.dataset.n!, s = el.dataset.s ?? '', t0 = performance.now();
    const step = (t: number) => {
      const p = Math.min((t - t0) / 1200, 1);
      el.innerHTML = Math.round(n * (1 - Math.pow(1 - p, 3))) + (s ? `<small>${s}</small>` : '');
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }), { threshold: .6 });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('[data-n]').forEach((el) => io.observe(el));
</script>
