---
import ServicePage from '../../../components/ServicePage.astro';
import blazer from '../../../assets/photos/blazer.jpg';
import yangiHayot from '../../../assets/photos/yangi-hayot.jpg';
import blackRed from '../../../assets/photos/black-red.jpg';
import teal from '../../../assets/photos/teal-dress.jpg';
import greenGown from '../../../assets/photos/green-gown.jpg';
---
<ServicePage
  slug="korporativ-tadbirlar"
  title="Корпоратив тадбирлар ва тақдимотлар"
  titleHtml="Корпоратив тадбирлар ва <em>тақдимотлар</em>"
  serviceType="Корпоратив тадбирлар бошловчиси"
  description="Бизнес-форумлар, бренд очилишлари, тақдимотлар, давлат ва хусусий компаниялар тадбирларини профессионал даражада олиб бориш."
  image={blazer}
  intro={[
    'Корпоратив тадбирда бошловчи брендни, ташкилотни ва меҳмонларни бирлаштирадиган овоздир.',
    'Форум, конференция, бренд ёки дўкон очилиши, йиллик кечалар ва тақдимотларни расмий ва жонли услубда олиб бораман.',
  ]}
  features={[
    { t: 'Бизнес-форумлар', d: 'Расмий протокол, спикерлар ва панел муҳокамалар.' },
    { t: 'Бренд очилишлари', d: 'Ресторан, дўкон ва бренд очилишлари — медиа ёритиш билан.' },
    { t: 'Тақдимотлар', d: 'Маҳсулот ва лойиҳа тақдимотлари, йиллик кечалар.' },
  ]}
  videos={[
    { file: 'islom-sivilizatsiyasi-markazi.mp4', poster: blackRed, title: 'Ислом цивилизацияси маркази', tag: 'Тадбир' },
    { file: 'yangi-hayot-studiyasi.mp4', poster: yangiHayot, title: '«Янги ҳаёт» студиясида', tag: 'ТВ' },
  ]}
  gallery={[blazer, teal, greenGown, yangiHayot]}
  steps={[
    { t: 'Бриф', d: 'Тадбир мақсади, аудиторияси ва дастури ҳақида маълумот оламиз.' },
    { t: 'Сценарий', d: 'Протокол, спикерлар тартиби ва матнлар тайёрланади.' },
    { t: 'Репетиция', d: 'Керак бўлса, жойида техник ва вақт бўйича текширув.' },
    { t: 'Тадбир', d: 'Тадбир режа бўйича, вақтида ва юқори савияда ўтади.' },
  ]}
  faq={[
    { q: 'Қайси тилларда олиб борасиз?', a: 'Ўзбек ва рус тилларида.' },
    { q: 'Очилиш маросимини медиада ёритиш мумкинми?', a: 'Ҳа, «Очилиш + медиа ёритиш» комбо пакети бор — батафсил Ҳамкорлик саҳифасида.' },
    { q: 'Сценарийни ким ёзади?', a: 'Сценарий буюртмачи билан келишилган ҳолда тайёрланади.' },
  ]}
  direction="korporativ"
/>
