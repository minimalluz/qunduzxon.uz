---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import toy from '../../../assets/photos/toy.jpg';
import blazer from '../../../assets/photos/blazer.jpg';
import radio from '../../../assets/photos/radio.jpg';

const crumbs = [{ href: '/uz/boshlovchi/', label: 'Бошловчи' }];
const items = [
  { href: '/uz/boshlovchi/toy-va-tantanalar/', img: toy, t: 'Тўй ва тантаналар', d: 'Тўй, никоҳ кечаси, юбилей — миллий ва замонавий услубда, икки тилда.' },
  { href: '/uz/boshlovchi/korporativ-tadbirlar/', img: blazer, t: 'Корпоратив тадбирлар', d: 'Форумлар, бренд очилишлари, тақдимотлар ва йиллик кечалар.' },
  { href: '/uz/boshlovchi/tv-radio-ovoz/', img: radio, t: 'ТВ, радио ва дикторлик', d: 'Кўрсатувлар, радио эфирлари ва реклама учун овоз бериш.' },
];
---
<Base title="Бошловчилик хизматлари" description="Тўй ва тантаналар, корпоратив тадбирлар, ТВ, радио ва дикторлик — Қундузхон Абдуллаеванинг бошловчилик хизматлари." crumbs={crumbs} ruHref="/ru/boshlovchi/">
  <PageHero crumbs={crumbs} eyebrow="Хизматлар" lead="Саҳнада, эфирда ва микрофон олдида — ҳар бир тадбирга алоҳида ёндашув.">
    Бошловчилик <em>хизматлари</em>
  </PageHero>
  <section class="sec">
    <div class="wrap list">
      {items.map((i) => (
        <a class="item" href={i.href}>
          <Image src={i.img} alt={i.t} widths={[480, 800]} sizes="(min-width:860px) 33vw, 100vw" />
          <div><h2>{i.t}</h2><p>{i.d}</p><span class="go">Батафсил →</span></div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .list { display: grid; gap: 18px; }
  @media (min-width: 860px) { .list { grid-template-columns: repeat(3, 1fr); } }
  .item { display: block; background: #fff; border-radius: var(--r); overflow: hidden; box-shadow: 0 1px 0 var(--color-line); }
  .item :global(img) { width: 100%; aspect-ratio: 4/5; object-fit: cover; transition: transform .5s; }
  .item:hover :global(img) { transform: scale(1.03); }
  .item div { padding: 20px 22px 24px; }
  .item h2 { font-size: 30px; }
  .item p { color: var(--color-muted); margin-top: 6px; }
  .go { display: inline-block; margin-top: 12px; font-weight: 600; color: var(--color-rose-dk); }
</style>
