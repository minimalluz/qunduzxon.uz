---
import ServicePage from '../../../components/ServicePage.astro';
import toy from '../../../assets/photos/toy.jpg';
import national from '../../../assets/photos/national.jpg';
import greenGown from '../../../assets/photos/green-gown.jpg';
import teal from '../../../assets/photos/teal-dress.jpg';
import eventGreen from '../../../assets/photos/event-green.jpg';
import nightRoses from '../../../assets/photos/night-roses.jpg';
import flowers from '../../../assets/photos/flowers.jpg';
---
<ServicePage
  slug="toy-va-tantanalar"
  title="Тўй ва тантаналар бошловчиси"
  titleHtml="Тўй ва <em>тантаналар</em> бошловчиси"
  serviceType="Тўй ва тантаналар бошловчиси"
  description="Тўй, никоҳ кечаси, юбилей ва оилавий тантаналарни миллий ва замонавий услубда, ўзбек ва рус тилларида олиб бориш."
  image={toy}
  intro={[
    'Тўй — оиланинг энг ёрқин куни. Бошловчининг вазифаси — шу кун бир маромда, самимий ва унутилмас ўтишини таъминлаш.',
    'Миллий урф-одатларни ҳурмат қилган ҳолда замонавий услубда олиб бораман. Керак бўлса, тантанани ўзбек ва рус тилларида олиб бориш мумкин.',
  ]}
  features={[
    { t: 'Миллий ва замонавий', d: 'Анъанавий маросимлар ва замонавий шоу элементлари уйғунлиги.' },
    { t: 'Икки тилда', d: 'Ўзбек ва рус тилларида — меҳмонларнинг ҳаммаси учун тушунарли.' },
    { t: 'Тайёргарлик', d: 'Сценарий, кетма-кетлик ва табриклар олдиндан келишилади.' },
  ]}
  videos={[
    { file: 'toyga-ham-ulgurdim.mp4', poster: national, title: 'Тўйга ҳам улгурдим', tag: 'Тўй' },
    { file: 'oq-libos.mp4', poster: greenGown, title: 'Оқ либос', tag: 'Тўй' },
    { file: 'qizil-gilamda.mp4', poster: eventGreen, title: 'Қизил гиламда', tag: 'Саҳна' },
    { file: 'sevgi-haqida.mp4', poster: nightRoses, title: 'Севги ҳақида', tag: 'Лавҳа' },
  ]}
  gallery={[toy, teal, greenGown, flowers]}
  steps={[
    { t: 'Мурожаат', d: 'Telegram ёки форма орқали сана ва тадбир ҳақида ёзасиз.' },
    { t: 'Учрашув', d: 'Тантананинг руҳи, меҳмонлар ва дастурни келишиб оламиз.' },
    { t: 'Сценарий', d: 'Кетма-кетлик, табриклар ва мусиқа созланади.' },
    { t: 'Тантана куни', d: 'Тадбир бошидан охиригача бир маромда ўтади.' },
  ]}
  faq={[
    { q: 'Қанча олдин банд қилиш керак?', a: 'Тўй мавсумида саналар тез банд бўлади, шунинг учун имкон қадар эртароқ ёзишингизни тавсия қиламиз.' },
    { q: 'Тантанани икки тилда олиб борасизми?', a: 'Ҳа, керак бўлса тадбир ўзбек ва рус тилларида олиб борилади.' },
    { q: 'Сценарийни ким тайёрлайди?', a: 'Сценарий сиз билан бирга, оилангизнинг истаклари асосида тайёрланади.' },
    { q: 'Нарх қанча?', a: 'Нарх сана, жой ва тадбир давомийлигига боғлиқ. Аниқ нархни Telegram орқали сўранг.' },
  ]}
  direction="toy"
  testimonialsNote
/>
