---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LeadForm from '../../components/LeadForm.astro';
import { TG_URL, STATS } from '../../config';
import food from '../../assets/photos/food.jpg';
import green from '../../assets/photos/green.jpg';
import blazer from '../../assets/photos/blazer.jpg';

const crumbs = [{ href: '/uz/hamkorlik/', label: 'Ҳамкорлик' }];
const packs = [
  { n: '01', t: 'Фуд-обзор ва Reels', d: 'Ресторан ёки маҳсулот ҳақида видео-обзор, Instagram/Telegram учун Reels ва сайтда шарҳ.', img: food },
  { n: '02', t: 'Очилиш + медиа ёритиш', d: 'Ресторан ёки дўкон тантанали очилишини олиб бориш ва уни ижтимоий тармоқларда ёритиш — комбо пакет.', img: blazer, hot: true },
  { n: '03', t: 'Бренд амбассадорлиги', d: 'Брендингиз билан узоқ муддатли ҳамкорлик: доимий контент, тадбирлар ва эфирлардаги эслатмалар.', img: green },
];
---
<Base title="Реклама ва ҳамкорлик — Media-Kit" description="Ресторан эгалари ва реклама берувчилар учун: аудитория, қамров ва ҳамкорлик пакетлари — фуд-обзор, очилиш маросими, бренд амбассадорлиги." crumbs={crumbs} image={food}>
  <PageHero crumbs={crumbs} eyebrow="Media-Kit" lead="Ресторан эгалари, брендлар ва реклама берувчилар учун ҳамкорлик имкониятлари.">
    Реклама ва <em>ҳамкорлик</em>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">Аудитория</p>
      <h2>Рақамларда</h2>
      <div class="kpis">
        {STATS.map((s) => <div><b>{s.n}{s.suffix}</b><span>{s.label}</span></div>)}
      </div>
      <div class="placeholder" style="margin-top:24px">
        Ижтимоий тармоқлар бўйича аниқ статистика керак: ҳар бир тармоқдаги обуначилар, ўртача қамров ва просмотрлар, аудитория портрети (ёш, жинс, шаҳарлар). Instagram ва Telegram статистикасидан скриншот юборилса, шу ерга жойланади.
      </div>
    </div>
  </section>

  <section class="sec" style="background:#fff">
    <div class="wrap">
      <p class="eyebrow">Пакетлар</p>
      <h2>Ҳамкорлик пакетлари</h2>
      <div class="packs">
        {packs.map((p) => (
          <article class:list={['pack', { hot: p.hot }]}>
            <Image src={p.img} alt="" widths={[400, 640]} sizes="(min-width:860px) 33vw, 100vw" loading="lazy" />
            <div>
              <span class="n">{p.n}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
              <a class="btn btn-rose" href={TG_URL} target="_blank" rel="noopener">Нархни сўраш</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec onair">
    <div class="wrap">
      <p class="eyebrow">Ариза</p>
      <h2>Ҳамкорликни муҳокама қилайлик</h2>
      <p class="lead">Брендингиз ва ғоянгиз ҳақида қисқача ёзинг — тез орада боғланамиз.</p>
      <LeadForm direction="food" full submitLabel="Ариза юбориш" />
    </div>
  </section>
</Base>

<style>
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; }
  .kpis div { background: #fff; border-radius: var(--r); padding: 22px 14px; text-align: center; box-shadow: 0 1px 0 var(--color-line); }
  .kpis b { display: block; font-family: var(--font-serif); font-size: clamp(30px, 6vw, 52px); color: var(--color-rose-dk); line-height: 1; }
  .kpis span { display: block; margin-top: 8px; font-size: 13px; color: var(--color-muted); }
  .packs { display: grid; gap: 18px; margin-top: 28px; }
  @media (min-width: 860px) { .packs { grid-template-columns: repeat(3, 1fr); } }
  .pack { border-radius: var(--r); overflow: hidden; background: var(--color-ivory); display: flex; flex-direction: column; }
  .pack.hot { outline: 2px solid var(--color-rose); }
  .pack :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .pack div { padding: 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .pack .n { font-family: var(--font-serif); font-size: 22px; color: var(--color-rose); font-weight: 700; }
  .pack h3 { font-size: 28px; }
  .pack p { color: var(--color-muted); flex: 1; }
  .pack .btn { align-self: flex-start; margin-top: 8px; }
</style>
