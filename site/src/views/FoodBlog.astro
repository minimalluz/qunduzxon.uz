---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { allReviews, CUISINES, cuisineLabel } from '../lib/reviews';
import type { Lang } from '../i18n';
import food from '../assets/photos/food.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  uz: {
    crumb: 'Фуд-блог', title: 'Фуд-блог ва гастро-гид',
    description: 'Ўзбекистон бўйлаб ресторан, қаҳвахона ва миллий таомлар ҳақида Қундузхон Абдуллаеванинг шарҳлари: таом, хизмат, муҳит ва нарх бўйича баҳолар.',
    lead: 'Ресторанлар, қаҳвахоналар ва миллий таомлар ҳақида ҳалол шарҳлар — таом мазаси, хизмат, муҳит ва нарх бўйича баҳо.',
    h1a: 'Гастро-', h1b: 'гид', q: 'Ресторан ёки таом номи…', search: 'Қидириш', cuisine: 'Ошхона тури', allCuisines: 'Барча ошхоналар',
    city: 'Шаҳар', allCities: 'Барча шаҳарлар', sort: 'Саралаш', newest: 'Энг янгилари', best: 'Энг юқори баҳо',
    count: '{n} та шарҳ', empty: 'Ҳеч нарса топилмади. Филтрни ўзгартириб кўринг.',
  },
  ru: {
    crumb: 'Фуд-блог', title: 'Фуд-блог и гастрогид',
    description: 'Обзоры Кундузхон Абдуллаевой о ресторанах, кофейнях и национальных блюдах по всему Узбекистану: оценки вкуса, обслуживания, атмосферы и цены.',
    lead: 'Честные обзоры ресторанов, кофеен и национальных блюд — оценки вкуса, обслуживания, атмосферы и цены.',
    h1a: 'Гастро', h1b: 'гид', q: 'Название ресторана или блюда…', search: 'Поиск', cuisine: 'Тип кухни', allCuisines: 'Все кухни',
    city: 'Город', allCities: 'Все города', sort: 'Сортировка', newest: 'Сначала новые', best: 'Самая высокая оценка',
    count: 'Обзоров: {n}', empty: 'Ничего не найдено. Попробуйте изменить фильтр.',
  },
}[lang];

const reviews = await allReviews(lang);
const cities = [...new Set(reviews.map((r) => r.t.city))].sort();
const crumbs = [{ href: `/${lang}/food-blog/`, label: T.crumb }];
---
<Base lang={lang} title={T.title} description={T.description} image={food} crumbs={crumbs}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.crumb} lead={T.lead}>
    {T.h1a}<em>{T.h1b}</em>
  </PageHero>

  <section class="sec food-sec">
    <div class="wrap">
      <form class="filters" id="filters" role="search" onsubmit="return false" data-count={T.count}>
        <input type="search" id="q" placeholder={T.q} aria-label={T.search} />
        <select id="cuisine" aria-label={T.cuisine}><option value="">{T.allCuisines}</option>{CUISINES.map((c) => <option value={c}>{cuisineLabel(c, lang)}</option>)}</select>
        <select id="city" aria-label={T.city}><option value="">{T.allCities}</option>{cities.map((c) => <option>{c}</option>)}</select>
        <select id="sort" aria-label={T.sort}><option value="new">{T.newest}</option><option value="score">{T.best}</option></select>
      </form>
      <p class="count" id="count" aria-live="polite">{T.count.replace('{n}', String(reviews.length))}</p>
      <div class="grid" id="grid">{reviews.map((r) => <ReviewCard review={r} lang={lang} />)}</div>
      <p class="empty" id="empty" hidden={reviews.length > 0}>{T.empty}</p>
    </div>
  </section>
</Base>

<style>
  .filters { display: grid; gap: 10px; }
  .filters input, .filters select { min-height: 48px; border-radius: 12px; border: 1px solid #F0D9C4; background: #fff; padding: 0 14px; font: 15px var(--font-sans); width: 100%; }
  @media (min-width: 860px) { .filters { grid-template-columns: 2fr 1fr 1fr 1fr; } }
  .count { margin: 18px 0 8px; font-size: 14px; color: var(--color-muted); }
  .grid { display: grid; gap: 16px; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .empty { padding: 40px 0; text-align: center; color: var(--color-muted); }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('q'), cuisine = $<HTMLSelectElement>('cuisine'), city = $<HTMLSelectElement>('city'), sort = $<HTMLSelectElement>('sort');
  const grid = $('grid'), count = $('count'), empty = $('empty');
  const cards = [...grid.querySelectorAll<HTMLElement>('article')];
  const original = [...cards];
  const apply = () => {
    const text = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok = (!text || c.dataset.text!.includes(text))
        && (!cuisine.value || c.dataset.cuisine!.split('|').includes(cuisine.value))
        && (!city.value || c.dataset.city === city.value);
      c.hidden = !ok;
      if (ok) shown++;
    }
    const order = sort.value === 'score' ? [...cards].sort((a, b) => +b.dataset.score! - +a.dataset.score!) : original;
    order.forEach((c) => grid.appendChild(c));
    count.textContent = $('filters').dataset.count!.replace('{n}', String(shown));
    empty.hidden = shown > 0;
  };
  [q, cuisine, city, sort].forEach((el) => el.addEventListener('input', apply));
</script>
