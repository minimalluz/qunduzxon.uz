---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import { TG_URL } from '../config';
import { STATS_L, type Lang } from '../i18n';
import food from '../assets/photos/food.jpg';
import green from '../assets/photos/green.jpg';
import blazer from '../assets/photos/blazer.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const STATS = STATS_L[lang];
const T = {
  uz: {
    crumb: 'Ҳамкорлик', title: 'Реклама ва ҳамкорлик — Media-Kit',
    description: 'Ресторан эгалари ва реклама берувчилар учун: аудитория, қамров ва ҳамкорлик пакетлари — фуд-обзор, очилиш маросими, бренд амбассадорлиги.',
    lead: 'Ресторан эгалари, брендлар ва реклама берувчилар учун ҳамкорлик имкониятлари.',
    h1a: 'Реклама ва ', h1b: 'ҳамкорлик',
    audEy: 'Аудитория', audH: 'Рақамларда',
    audNote: 'Ижтимоий тармоқлар бўйича аниқ статистика керак: ҳар бир тармоқдаги обуначилар, ўртача қамров ва просмотрлар, аудитория портрети (ёш, жинс, шаҳарлар). Instagram ва Telegram статистикасидан скриншот юборилса, шу ерга жойланади.',
    packEy: 'Пакетлар', packH: 'Ҳамкорлик пакетлари', price: 'Нархни сўраш',
    packs: [
      { t: 'Фуд-обзор ва Reels', d: 'Ресторан ёки маҳсулот ҳақида видео-обзор, Instagram/Telegram учун Reels ва сайтда шарҳ.' },
      { t: 'Очилиш + медиа ёритиш', d: 'Ресторан ёки дўкон тантанали очилишини олиб бориш ва уни ижтимоий тармоқларда ёритиш — комбо пакет.' },
      { t: 'Бренд амбассадорлиги', d: 'Брендингиз билан узоқ муддатли ҳамкорлик: доимий контент, тадбирлар ва эфирлардаги эслатмалар.' },
    ],
    formEy: 'Ариза', formH: 'Ҳамкорликни муҳокама қилайлик', formLead: 'Брендингиз ва ғоянгиз ҳақида қисқача ёзинг — тез орада боғланамиз.',
    submit: 'Ариза юбориш',
  },
  ru: {
    crumb: 'Сотрудничество', title: 'Реклама и сотрудничество — Media-Kit',
    description: 'Для владельцев ресторанов и рекламодателей: аудитория, охваты и пакеты сотрудничества — фуд-обзор, церемония открытия, амбассадорство бренда.',
    lead: 'Возможности сотрудничества для владельцев ресторанов, брендов и рекламодателей.',
    h1a: 'Реклама и ', h1b: 'сотрудничество',
    audEy: 'Аудитория', audH: 'В цифрах',
    audNote: 'Нужна точная статистика по соцсетям: подписчики в каждой сети, средние охваты и просмотры, портрет аудитории (возраст, пол, города). Если прислать скриншоты статистики Instagram и Telegram, они будут размещены здесь.',
    packEy: 'Пакеты', packH: 'Пакеты сотрудничества', price: 'Узнать цену',
    packs: [
      { t: 'Фуд-обзор и Reels', d: 'Видеообзор ресторана или продукта, Reels для Instagram/Telegram и обзор на сайте.' },
      { t: 'Открытие + освещение в медиа', d: 'Ведение торжественного открытия ресторана или магазина и его освещение в соцсетях — комбо-пакет.' },
      { t: 'Амбассадорство бренда', d: 'Долгосрочное сотрудничество с вашим брендом: регулярный контент, мероприятия и упоминания в эфирах.' },
    ],
    formEy: 'Заявка', formH: 'Давайте обсудим сотрудничество', formLead: 'Коротко напишите о вашем бренде и идее — мы скоро свяжемся с вами.',
    submit: 'Отправить заявку',
  },
}[lang];
const crumbs = [{ href: `/${lang}/hamkorlik/`, label: T.crumb }];
const packs = [
  { n: '01', ...T.packs[0], img: food },
  { n: '02', ...T.packs[1], img: blazer, hot: true },
  { n: '03', ...T.packs[2], img: green },
];
---
<Base lang={lang} title={T.title} description={T.description} crumbs={crumbs} image={food}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow="Media-Kit" lead={T.lead}>
    {T.h1a}<em>{T.h1b}</em>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">{T.audEy}</p>
      <h2>{T.audH}</h2>
      <div class="kpis">
        {STATS.map((s) => <div><b>{s.n}{s.suffix}</b><span>{s.label}</span></div>)}
      </div>
      <div class="placeholder" style="margin-top:24px">
        {T.audNote}
      </div>
    </div>
  </section>

  <section class="sec" style="background:#fff">
    <div class="wrap">
      <p class="eyebrow">{T.packEy}</p>
      <h2>{T.packH}</h2>
      <div class="packs">
        {packs.map((p) => (
          <article class:list={['pack', { hot: p.hot }]}>
            <Image src={p.img} alt="" widths={[400, 640]} sizes="(min-width:860px) 33vw, 100vw" loading="lazy" />
            <div>
              <span class="n">{p.n}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
              <a class="btn btn-rose" href={TG_URL} target="_blank" rel="noopener">{T.price}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec onair">
    <div class="wrap">
      <p class="eyebrow">{T.formEy}</p>
      <h2>{T.formH}</h2>
      <p class="lead">{T.formLead}</p>
      <LeadForm lang={lang} direction="food" full submitLabel={T.submit} />
    </div>
  </section>
</Base>
<style>
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; }
  .kpis div { background: #fff; border-radius: var(--r); padding: 22px 14px; text-align: center; box-shadow: 0 1px 0 var(--color-line); }
  .kpis b { display: block; font-family: var(--font-serif); font-size: clamp(30px, 6vw, 52px); color: var(--color-rose-dk); line-height: 1; }
  .kpis span { display: block; margin-top: 8px; font-size: 13px; color: var(--color-muted); }
  .packs { display: grid; gap: 18px; margin-top: 28px; }
  @media (min-width: 860px) { .packs { grid-template-columns: repeat(3, 1fr); } }
  .pack { border-radius: var(--r); overflow: hidden; background: var(--color-ivory); display: flex; flex-direction: column; }
  .pack.hot { outline: 2px solid var(--color-rose); }
  .pack :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .pack div { padding: 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .pack .n { font-family: var(--font-serif); font-size: 22px; color: var(--color-rose); font-weight: 700; }
  .pack h3 { font-size: 28px; }
  .pack p { color: var(--color-muted); flex: 1; }
  .pack .btn { align-self: flex-start; margin-top: 8px; }
</style>
