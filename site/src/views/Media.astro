---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import VideoCard from '../components/VideoCard.astro';
import { SITE_L, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const cat: Record<string, 'toy' | 'tv' | 'food' | 'life'> = {
  toy: 'toy', 'teal-dress': 'toy', 'green-gown': 'toy', 'event-green': 'toy', 'night-roses': 'toy', flowers: 'life',
  radio: 'tv', studio: 'tv', mic: 'tv', orange: 'tv', 'yangi-hayot': 'tv', football: 'tv', hero: 'tv', 'black-red': 'tv', blazer: 'toy',
  food: 'food', national: 'food', green: 'food', autumn: 'life', about: 'life', denim: 'life', 'blue-ikat': 'life', mountain: 'life',
};
const photos = await Promise.all(
  Object.entries(files).map(async ([path, mod]) => {
    const key = path.split('/').pop()!.replace('.jpg', '');
    const big = await getImage({ src: mod.default, width: 1280, format: 'webp', quality: 75 });
    return { key, img: mod.default, big: big.src, cat: cat[key] ?? 'life' };
  }),
);
const posterOf = (k: string) => photos.find((p) => p.key === k)!.img;
const T = {
  uz: {
    crumb: 'Медиа', title: 'Медиа галерея ва портфолио',
    description: 'Қундузхон Абдуллаеванинг фото ва видео ишлари: тўйлар, телевидение ва радио эфирлари, фуд-блог.',
    eyebrow: 'Портфолио', h1a: 'Медиа', h1b: 'галерея', filter: 'Филтр', video: 'Видео', photo: 'Фото',
    lb: 'Расмни катта кўриш', close: 'Ёпиш', prev: 'Олдинги', next: 'Кейинги',
    tabs: ['Барчаси', 'Тўйлар', 'ТВ ва радио', 'Фуд-блог', 'Ҳаёт'],
    videos: [
      ['Hit FM эфирида', 'Радио'], ['Радио эфирида', 'Радио'], ['Студияда суҳбат', 'ТВ'], ['«Янги ҳаёт» студияси', 'ТВ'],
      ['Тўйга ҳам улгурдим', 'Тўй'], ['Қизил гиламда', 'Саҳна'], ['Жиззах миллий таомлари', 'Фуд'], ['Шоколадли торт', 'Фуд'],
    ],
  },
  ru: {
    crumb: 'Медиа', title: 'Медиагалерея и портфолио',
    description: 'Фото и видео Кундузхон Абдуллаевой: свадьбы, теле- и радиоэфиры, фуд-блог.',
    eyebrow: 'Портфолио', h1a: 'Медиа', h1b: 'галерея', filter: 'Фильтр', video: 'Видео', photo: 'Фото',
    lb: 'Просмотр фото', close: 'Закрыть', prev: 'Предыдущее', next: 'Следующее',
    tabs: ['Все', 'Свадьбы', 'ТВ и радио', 'Фуд-блог', 'Жизнь'],
    videos: [
      ['В эфире Hit FM', 'Радио'], ['В радиоэфире', 'Радио'], ['Беседа в студии', 'ТВ'], ['Студия «Янги хаёт»', 'ТВ'],
      ['Успела и на свадьбу', 'Свадьба'], ['На красной дорожке', 'Сцена'], ['Национальные блюда Джизака', 'Фуд'], ['Шоколадный торт', 'Фуд'],
    ],
  },
}[lang];
const videoFiles = [
  { file: 'hit-fm-efirida.mp4', poster: posterOf('mic'), cat: 'tv' },
  { file: 'radio-efirida.mp4', poster: posterOf('studio'), cat: 'tv' },
  { file: 'studiyada-suhbat.mp4', poster: posterOf('orange'), cat: 'tv' },
  { file: 'yangi-hayot-studiyasi.mp4', poster: posterOf('yangi-hayot'), cat: 'tv' },
  { file: 'toyga-ham-ulgurdim.mp4', poster: posterOf('national'), cat: 'toy' },
  { file: 'qizil-gilamda.mp4', poster: posterOf('event-green'), cat: 'toy' },
  { file: 'jizzax-milliy-taomlari.mp4', poster: posterOf('food'), cat: 'food' },
  { file: 'shokoladli-tort.mp4', poster: posterOf('green'), cat: 'food' },
];
const videos = videoFiles.map((v, i) => ({ ...v, title: T.videos[i][0], tag: T.videos[i][1] }));
const tabs = ['all', 'toy', 'tv', 'food', 'life'].map((v, i) => ({ v, t: T.tabs[i] }));
const crumbs = [{ href: `/${lang}/media/`, label: T.crumb }];
const photoAlt = SITE_L[lang].name;
---
<Base lang={lang} title={T.title} description={T.description} crumbs={crumbs}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.eyebrow}>{T.h1a} <em>{T.h1b}</em></PageHero>

  <section class="sec" style="padding-top:32px">
    <div class="wrap">
      <div class="tabs" role="tablist" aria-label={T.filter}>
        {tabs.map((t, i) => <button role="tab" type="button" data-f={t.v} aria-selected={i === 0 ? 'true' : 'false'}>{t.t}</button>)}
      </div>

      <h2 class="sub">{T.video}</h2>
      <div class="vgrid">
        {videos.map((v) => <div data-cat={v.cat} class="it"><VideoCard file={v.file} poster={v.poster} title={v.title} tag={v.tag} sizes="(min-width:1000px) 25vw, 50vw" lang={lang} /></div>)}
      </div>

      <h2 class="sub">{T.photo}</h2>
      <div class="pgrid">
        {photos.map((p) => (
          <a class="it ph" data-cat={p.cat} href={p.big} data-lb>
            <Image src={p.img} alt={photoAlt} widths={[300, 480]} sizes="(min-width:1000px) 25vw, 50vw" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <dialog id="lb" aria-label={T.lb}>
    <button type="button" class="lb-x" aria-label={T.close}>×</button>
    <button type="button" class="lb-p" aria-label={T.prev}>‹</button>
    <img alt="" />
    <button type="button" class="lb-n" aria-label={T.next}>›</button>
  </dialog>
</Base>

<style>
  .tabs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .tabs button { flex: none; padding: 10px 18px; border-radius: 999px; border: 1px solid var(--color-line); background: #fff; font-weight: 600; font-size: 14px; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  .sub { font-size: 34px; margin: 36px 0 16px; }
  .vgrid, .pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 1000px) { .vgrid, .pgrid { grid-template-columns: repeat(4, 1fr); } }
  .it[hidden] { display: none; }
  .ph :global(img) { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 12px; transition: opacity .2s; }
  .ph:hover :global(img) { opacity: .88; }
  dialog { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  dialog::backdrop { background: rgba(10,6,8,.92); }
  dialog[open] { display: grid; place-items: center; }
  dialog img { max-width: min(92vw, 900px); max-height: 86vh; border-radius: 10px; object-fit: contain; }
  dialog button { position: fixed; color: #fff; font-size: 40px; width: 56px; height: 56px; display: grid; place-items: center; background: rgba(255,255,255,.08); border-radius: 50%; cursor: pointer; }
  .lb-x { top: 16px; right: 16px; } .lb-p { left: 12px; top: 50%; translate: 0 -50%; } .lb-n { right: 12px; top: 50%; translate: 0 -50%; }
</style>

<script>
  // Филтр
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
  const items = [...document.querySelectorAll<HTMLElement>('.it')];
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    items.forEach((i) => (i.hidden = t.dataset.f !== 'all' && i.dataset.cat !== t.dataset.f));
  }));

  // Lightbox
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = lb.querySelector('img')!;
  let cur = 0;
  const visible = () => [...document.querySelectorAll<HTMLAnchorElement>('a[data-lb]')].filter((a) => !a.hidden);
  const show = (i: number) => { const v = visible(); cur = (i + v.length) % v.length; img.src = v[cur].href; };
  document.querySelectorAll<HTMLAnchorElement>('a[data-lb]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); show(visible().indexOf(a)); lb.showModal();
  }));
  lb.querySelector('.lb-x')!.addEventListener('click', () => lb.close());
  lb.querySelector('.lb-p')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('.lb-n')!.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
  let x0 = 0;
  lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); });
</script>
