---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import type { Lang } from '../i18n';
import ona1 from '../assets/ona/ona-1.jpg';
import ona2 from '../assets/ona/ona-2.jpg';
import ona3 from '../assets/ona/ona-3.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  uz: {
    crumb: 'Менинг онам', title: 'Менинг онам',
    lead: 'Ҳаётимдаги энг қимматли инсон — менга ҳаёт берган, тарбиялаган ва доимо қўллаб-қувватлаган меҳрибон онажоним ҳақида.',
    h1a: 'Ҳаётимдаги энг ', h1b: 'қимматли инсон',
    values: [{ icon: '❤', t: 'Меҳр' }, { icon: '🤲', t: 'Дуо' }, { icon: '💐', t: 'Ҳурмат' }],
    quote: '«Она — бу дунёдаги энг муқаддас сўз, она меҳри — энг буюк неъмат.»',
    alt: 'Онам билан', aboutH: 'Онам ҳақида',
    about: [
      'Менинг онам — ҳаётимдаги энг муҳим инсон. У менга фақат ҳаёт бергани эмас, балки ҳаётда тўғри йўлни топишга, меҳрибон ва ғамхўр бўлишга ўргатди.',
      'Онамнинг меҳри ва қўллаб-қувватлаши туфайли мен бугунги кунда ўз орзуларимга эришдим. Унинг ҳар бир маслаҳати, ҳар бир дуоси мен учун бебаҳо.',
    ],
    thanks: 'Раҳмат, онажон! Сизни жуда яхши кўраман! ',
    galEy: 'Хотиралар галереяси', galH: 'Онам билан энг қимматли лаҳзаларим', galAlt: 'Онам билан хотира',
    closeH: 'Онажон, сизни яхши кўраман!',
    closeP: 'Сиз менинг ҳаётимдаги энг катта неъматсиз. Аллоҳ сизга узоқ умр ва саломатлик берсин!',
  },
  ru: {
    crumb: 'Моя мама', title: 'Моя мама',
    lead: 'Самый дорогой человек в моей жизни — о моей любящей маме, которая подарила мне жизнь, воспитала меня и всегда поддерживала.',
    h1a: 'Самый ', h1b: 'дорогой человек',
    values: [{ icon: '❤', t: 'Любовь' }, { icon: '🤲', t: 'Молитва' }, { icon: '💐', t: 'Уважение' }],
    quote: '«Мама — самое святое слово на свете, материнская любовь — величайший дар.»',
    alt: 'С мамой', aboutH: 'О моей маме',
    about: [
      'Моя мама — самый важный человек в моей жизни. Она не только подарила мне жизнь, но и научила находить верный путь, быть доброй и заботливой.',
      'Благодаря маминой любви и поддержке я сегодня осуществила свои мечты. Каждый её совет, каждая её молитва для меня бесценны.',
    ],
    thanks: 'Спасибо, мамочка! Я очень тебя люблю! ',
    galEy: 'Галерея воспоминаний', galH: 'Самые дорогие моменты с мамой', galAlt: 'Воспоминание с мамой',
    closeH: 'Мамочка, я тебя люблю!',
    closeP: 'Ты — самый большой дар в моей жизни. Пусть Всевышний дарует тебе долгую жизнь и здоровье!',
  },
}[lang];
const crumbs = [{ href: `/${lang}/onam/`, label: T.crumb }];
---
<Base lang={lang} title={T.title} description={T.lead} image={ona1} crumbs={crumbs}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.crumb} lead={T.lead}>
    {T.h1a}<em>{T.h1b}</em>
  </PageHero>

  <section class="sec mom-bg">
    <div class="wrap">
      <ul class="vals">
        {T.values.map((v) => <li><span aria-hidden="true">{v.icon}</span>{v.t}</li>)}
      </ul>
      <blockquote>{T.quote}</blockquote>

      <div class="about-mom">
        <Image src={ona1} alt={T.alt} widths={[480, 800]} sizes="(min-width:860px) 40vw, 100vw" class="mom-main" />
        <div class="prose-q">
          <h2>{T.aboutH}</h2>
          {T.about.map((p) => <p>{p}</p>)}
          <p class="thanks">{T.thanks}<span aria-hidden="true">❤️</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">{T.galEy}</p>
      <h2>{T.galH}</h2>
      <div class="gal">
        {[ona1, ona2, ona3].map((src) => <Image src={src} alt={T.galAlt} widths={[400, 700]} sizes="(min-width:720px) 33vw, 100vw" loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="sec onair closing">
    <div class="wrap">
      <h2>{T.closeH}</h2>
      <p class="lead">{T.closeP}</p>
    </div>
  </section>
</Base>
<style>
  .mom-bg { background: #FDF0F5; }
  .vals { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .vals li { display: flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 999px; background: #fff; color: var(--color-mauve); font-weight: 600; font-size: 17px; box-shadow: 0 1px 0 var(--color-line); }
  blockquote { font-family: var(--font-serif); font-style: italic; font-weight: 500; font-size: clamp(26px, 4.4vw, 40px); line-height: 1.3; text-align: center; max-width: 22em; margin: 40px auto; color: var(--color-ink); }
  .about-mom { display: grid; gap: 28px; align-items: center; margin-top: 24px; }
  .about-mom :global(.mom-main) { border-radius: var(--r); width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .about-mom h2 { margin-top: 0; }
  .thanks { font-family: var(--font-serif); font-size: 26px; font-weight: 700; color: var(--color-rose-dk); }
  @media (min-width: 860px) { .about-mom { grid-template-columns: .9fr 1.1fr; gap: 56px; } }
  .gal { display: grid; gap: 12px; margin-top: 28px; }
  .gal :global(img) { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 14px; }
  @media (min-width: 720px) { .gal { grid-template-columns: repeat(3, 1fr); } }
  .closing { text-align: center; }
  .closing .lead { margin-inline: auto; font-size: 19px; }
</style>
