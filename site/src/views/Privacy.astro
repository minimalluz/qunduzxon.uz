---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EMAIL } from '../config';
import { SITE_L, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const name = SITE_L[lang].name;
const T = {
  uz: {
    crumb: 'Махфийлик сиёсати', title: 'Махфийлик сиёсати',
    description: 'qunduzxon.uz сайтида шахсий маълумотлар қандай йиғилади ва ишлатилади.',
    h1a: 'Махфийлик ', h1b: 'сиёсати',
    note: 'Бу матн намуна. Эълон қилишдан олдин юрист ёки сайт эгаси томонидан текширилиши керак.',
    blocks: [
      { h: 'Қандай маълумот йиғилади', p: 'Сайтдаги формаларни тўлдирганингизда исмингиз, телефон рақамингиз, тадбир санаси, йўналиш ва изоҳингиз, шунингдек форма юборилган саҳифа манзили олинади.' },
      { h: 'Маълумот нима учун ишлатилади', p: 'Маълумотлар фақат аризангизга жавоб бериш ва сиз билан боғланиш учун ишлатилади. Улар учинчи шахсларга сотилмайди ва берилмайди.' },
      { h: 'Маълумот қаерга юборилади', p: `Ариза ${name} ва унинг маъмурининг ёпиқ Telegram гуруҳига юборилади. Спамдан ҳимоя учун Cloudflare Turnstile ишлатилади.` },
      { h: 'Аналитика', p: 'Сайт ишлашини яхшилаш учун ташрифлар ҳақида умумлаштирилган, шахсни аниқламайдиган статистика йиғилиши мумкин.' },
    ],
    contactH: 'Алоқа', contact: 'Маълумотларингизни ўчириш ёки улар ҳақида савол бўлса, ёзинг: ',
  },
  ru: {
    crumb: 'Политика конфиденциальности', title: 'Политика конфиденциальности',
    description: 'Как на сайте qunduzxon.uz собираются и используются персональные данные.',
    h1a: 'Политика ', h1b: 'конфиденциальности',
    note: 'Это текст-образец. Перед публикацией его должен проверить юрист или владелец сайта.',
    blocks: [
      { h: 'Какие данные собираются', p: 'Когда вы заполняете формы на сайте, мы получаем ваше имя, номер телефона, дату мероприятия, направление и комментарий, а также адрес страницы, с которой отправлена форма.' },
      { h: 'Для чего используются данные', p: 'Данные используются только для ответа на вашу заявку и связи с вами. Они не продаются и не передаются третьим лицам.' },
      { h: 'Куда отправляются данные', p: `Заявка отправляется в закрытую Telegram-группу Кундузхон Абдуллаевой и её администратора. Для защиты от спама используется Cloudflare Turnstile.` },
      { h: 'Аналитика', p: 'Для улучшения работы сайта может собираться обобщённая статистика посещений, не позволяющая установить личность.' },
    ],
    contactH: 'Контакты', contact: 'Если вы хотите удалить свои данные или у вас есть вопросы о них, напишите: ',
  },
}[lang];
const crumbs = [{ href: `/${lang}/privacy-policy/`, label: T.crumb }];
---
<Base lang={lang} title={T.title} description={T.description} crumbs={crumbs}>
  <PageHero lang={lang} crumbs={crumbs}>{T.h1a}<em>{T.h1b}</em></PageHero>
  <section class="sec">
    <div class="wrap prose-q">
      <p class="placeholder">{T.note}</p>
      {T.blocks.map((b) => <><h2>{b.h}</h2><p>{b.p}</p></>)}
      <h2>{T.contactH}</h2>
      <p>{T.contact}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    </div>
  </section>
</Base>
