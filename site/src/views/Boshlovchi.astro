---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import type { Lang } from '../i18n';
import toy from '../assets/photos/toy.jpg';
import blazer from '../assets/photos/blazer.jpg';
import radio from '../assets/photos/radio.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  uz: {
    crumb: 'Бошловчи', title: 'Бошловчилик хизматлари',
    description: 'Тўй ва тантаналар, корпоратив тадбирлар, ТВ, радио ва дикторлик — Қундузхон Абдуллаеванинг бошловчилик хизматлари.',
    eyebrow: 'Хизматлар', lead: 'Саҳнада, эфирда ва микрофон олдида — ҳар бир тадбирга алоҳида ёндашув.',
    h1a: 'Бошловчилик ', h1b: 'хизматлари', more: 'Батафсил →',
    items: [
      { t: 'Тўй ва тантаналар', d: 'Тўй, никоҳ кечаси, юбилей — миллий ва замонавий услубда, икки тилда.' },
      { t: 'Корпоратив тадбирлар', d: 'Форумлар, бренд очилишлари, тақдимотлар ва йиллик кечалар.' },
      { t: 'ТВ, радио ва дикторлик', d: 'Кўрсатувлар, радио эфирлари ва реклама учун овоз бериш.' },
    ],
  },
  ru: {
    crumb: 'Ведущая', title: 'Услуги ведущей',
    description: 'Свадьбы и торжества, корпоративные мероприятия, ТВ, радио и дикторская работа — услуги ведущей Кундузхон Абдуллаевой.',
    eyebrow: 'Услуги', lead: 'На сцене, в эфире и у микрофона — индивидуальный подход к каждому мероприятию.',
    h1a: 'Услуги ', h1b: 'ведущей', more: 'Подробнее →',
    items: [
      { t: 'Свадьбы и торжества', d: 'Свадьбы, никах, юбилеи — в национальном и современном стиле, на двух языках.' },
      { t: 'Корпоративные мероприятия', d: 'Форумы, открытия брендов, презентации и ежегодные вечера.' },
      { t: 'ТВ, радио и дикторская работа', d: 'Передачи, радиоэфиры и озвучивание рекламы.' },
    ],
  },
}[lang];
const crumbs = [{ href: `/${lang}/boshlovchi/`, label: T.crumb }];
const slugs = ['toy-va-tantanalar', 'korporativ-tadbirlar', 'tv-radio-ovoz'];
const imgs = [toy, blazer, radio];
const items = T.items.map((it, i) => ({ ...it, href: `/${lang}/boshlovchi/${slugs[i]}/`, img: imgs[i] }));
---
<Base lang={lang} title={T.title} description={T.description} crumbs={crumbs}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.eyebrow} lead={T.lead}>
    {T.h1a}<em>{T.h1b}</em>
  </PageHero>
  <section class="sec">
    <div class="wrap list">
      {items.map((i) => (
        <a class="item" href={i.href}>
          <Image src={i.img} alt={i.t} widths={[480, 800]} sizes="(min-width:860px) 33vw, 100vw" />
          <div><h2>{i.t}</h2><p>{i.d}</p><span class="go">{T.more}</span></div>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .list { display: grid; gap: 18px; }
  @media (min-width: 860px) { .list { grid-template-columns: repeat(3, 1fr); } }
  .item { display: block; background: #fff; border-radius: var(--r); overflow: hidden; box-shadow: 0 1px 0 var(--color-line); }
  .item :global(img) { width: 100%; aspect-ratio: 4/5; object-fit: cover; transition: transform .5s; }
  .item:hover :global(img) { transform: scale(1.03); }
  .item div { padding: 20px 22px 24px; }
  .item h2 { font-size: 30px; }
  .item p { color: var(--color-muted); margin-top: 6px; }
  .go { display: inline-block; margin-top: 12px; font-weight: 600; color: var(--color-rose-dk); }
</style>
