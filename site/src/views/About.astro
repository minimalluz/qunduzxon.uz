---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE as SITE_UZ, SOCIAL } from '../config';
import { SITE_L, STATS_L, type Lang } from '../i18n';
import about from '../assets/photos/about.jpg';
import studio from '../assets/photos/studio.jpg';
import yangiHayot from '../assets/photos/yangi-hayot.jpg';
import greenGown from '../assets/photos/green-gown.jpg';
import radio from '../assets/photos/radio.jpg';
import blueIkat from '../assets/photos/blue-ikat.jpg';
import football from '../assets/photos/football.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const SITE = { ...SITE_L[lang], url: SITE_UZ.url };
const STATS = STATS_L[lang];

// Матн эга томонидан берилган биография (2026-11-09) ва очиқ манбалар асосида — README'да манбалари билан.
const T = {
  uz: {
    crumb: 'Мен ҳақимда', title: 'Мен ҳақимда',
    description: 'Қундузхон Абдуллаева — телерадио бошловчи, нотиқлик санъати бўйича тренер, тантаналар бошловчиси ва блогер. Эфирда 16 йил.',
    eyebrow: 'Мен ҳақимда', h1a: 'Эфирда ', h1b: '16 йил', h1c: '',
    hello: 'Ассалому алайкум! Мен — Қундузхон Абдуллаева.',
    intro: [
      'Теле ва радио бошловчи, нотиқлик санъати бўйича тренер, тўй ва тантаналар бошловчиси ва блогерман. 16 йилдан бери эфирдаман: журналистикани «Сўғдиёна» газетасидан бошлаганман, кейин радио ва телеканалларда кўрсатувлар олиб бордим, минглаб тингловчи ва томошабинлар билан ҳар куни учрашдим.',
      'Бугун тўйлар, корпоратив тадбирлар ва расмий маросимларни олиб бораман, нотиқлик бўйича маҳорат дарслари ўтказаман, рекламаларни овозлаштираман ва фуд-блогимда Ўзбекистон таомлари ҳақида ҳикоя қиламан.',
      'Мен учун энг муҳими — тоза ва чиройли нутқ, самимий мулоқот ва ҳар бир инсонга ҳурмат.',
    ],
    introNote: '',
    pathEy: 'Йўл', pathH: 'Эфир ва саҳнадаги фаолият', pathNote: 'Йиллар ва аниқ саналар тасдиқлангач қўшилади.',
    path: [
      { t: 'Санъаткорлар оиласида', d: 'Отаси — Ўзбекистонда хизмат кўрсатган артист, бастакор, профессор Рустам Абдуллаев; онаси — консерваторияни тамомлаган мусиқа ўқитувчиси. Болалиги Фарғонада ўтган.' },
      { t: 'Мусиқа мактаби', d: 'Мактаб йилларида мусиқа мактабида 7 йил фортепиано ва 5 йил дутор бўйича ўқиган, хор ва сольфеджио дарсларига қатнашган.' },
      { t: 'Сўз ва микрофон', d: 'Мусиқачилик йўлидан кетиш имконияти бўлса-да, инглиз тили йўналишидаги академик лицейни, кейин микрофон қаршисида сўзлашга иштиёқи сабаб олийгоҳда журналистикани танлаган.' },
      { t: 'Матбуот мактаби', d: 'Журналистик фаолиятини «Сўғдиёна» газетасида бошлаган: устозлари журналистнинг қалами ва тили аввало матбуотда чархланишини уқтирган.' },
      { t: 'Радио', d: 'Узоқ йиллар радиода жонли эфирлар олиб борган: Zamin FM, Hit FM, 90.8 FM ва «Ёшлар» радиоси. Эфирлар ва тадбирларда кўпинча ҳамкасби Озод Равшан билан бирга чиққан.' },
      { t: 'Milliy TV', d: '«Миллий» телеканалида маърифий ва кўнгилочар кўрсатувлар олиб борган, жумладан «Ширчой» тонгги кўрсатуви.' },
      { t: '«Севимли» телеканали', d: 'Муаллифлик ва кўнгилочар лойиҳалар, шоу ва ток-шоулар, жумладан «Bollivud battl». Ҳозирда «Sevimli kun» ва ток-шоуларда бошловчи.' },
      { t: 'Эксперт ва суҳбатдош', d: '«Ёшлар» ва бошқа миллий телеканаллар кўрсатувларида («Жамулжам» ва бошқалар) доимий эксперт ва суҳбатдош.' },
      { t: 'Нотиқлик тренери', d: 'Аудитория олдида эркин сўзлаш, овозни тўғри қўйиш, дикция ва ҳаяжонни енгиш бўйича маҳорат дарслари ва тренинглар ўтказади.' },
      { t: 'Аёллар учун курслар', d: 'Хотин-қизларнинг жамиятдаги ўрни, психологик мустақиллиги, муомала маданияти ва нутқ техникаси бўйича муаллифлик курслари.' },
      { t: 'Ёшлар билан', d: 'Журналистика талабаларига телерадио бошловчилиги бўйича маҳорат дарслари; Ўзбекистон давлат санъат ва маданият институти каби олийгоҳларда медиа маданияти, нутқ санъати ва ижтимоий тармоқлар мавзусида амалий учрашувлар.' },
      { t: 'Блогер', d: 'Ижтимоий тармоқларда ярим миллионга яқин кузатувчи. Шахсий ривожланиш, оилавий қадриятлар, аёллар руҳияти ва муомала маданияти ҳақида видео ва фикрлар.' },
      { t: 'Фуд-блог', d: 'Ўзбекистон бўйлаб ресторан ва миллий таомлар ҳақида ҳалол шарҳлар, пазандалик рецептлари.' },
    ],
    valEy: 'Қадриятлар', valH: 'Ишлаш принципларим',
    values: [
      { t: 'Самимийлик', d: 'Ҳар бир эфир ва тадбирда — дилдан чиққан сўз.' },
      { t: 'Пухта тайёргарлик', d: 'Сценарий, меҳмонлар ва ҳар бир дақиқа олдиндан ўйланади.' },
      { t: 'Миллий қадрият', d: 'Анъаналарни ҳурмат қилиб, замонавий услубда олиб бориш.' },
    ],
    hobEy: 'Саҳнадан ташқарида', hobH: 'Қизиқишларим',
    hobbies: [
      { t: 'Спорт', d: 'Фитнес, бокс ва муай-тай билан мунтазам шуғулланаман. Спорт — стрессни енгиш ва руҳий тетикликнинг энг яхши воситаси.' },
      { t: 'Аудиокитоблар', d: 'Бўш вақтимда бадиий, психологик ва шахсий ривожланишга оид асарларни тинглайман.' },
    ],
    galEy: 'Ютуқлар ва ОАВ', galH: 'Эфирлар, мукофотлар, чиқишлар',
    galNote: 'Мукофотлар, сертификатлар ва ОАВдаги чиқишлар рўйхати керак — ҳозирча фақат расмлар.',
  },
  ru: {
    crumb: 'Обо мне', title: 'Обо мне',
    description: 'Кундузхон Абдуллаева — теле- и радиоведущая, тренер по ораторскому искусству, ведущая торжеств и блогер. 16 лет в эфире.',
    eyebrow: 'Обо мне', h1a: '', h1b: '16 лет', h1c: ' в эфире',
    hello: 'Ассалому алайкум! Я — Кундузхон Абдуллаева.',
    intro: [
      'Теле- и радиоведущая, тренер по ораторскому искусству, ведущая свадеб и торжеств, блогер. Я в эфире уже 16 лет: начинала в журналистике с газеты «Сугдиёна», затем вела передачи на радио и телеканалах, каждый день встречалась с тысячами слушателей и зрителей.',
      'Сегодня я веду свадьбы, корпоративные мероприятия и официальные церемонии, провожу мастер-классы по ораторскому искусству, озвучиваю рекламу, а в своём фуд-блоге рассказываю о блюдах Узбекистана.',
      'Для меня главное — чистая и красивая речь, искреннее общение и уважение к каждому человеку.',
    ],
    introNote: '',
    pathEy: 'Путь', pathH: 'В эфире и на сцене', pathNote: 'Годы и точные даты будут добавлены после подтверждения.',
    path: [
      { t: 'В семье артистов', d: 'Отец — заслуженный артист Узбекистана, композитор, профессор Рустам Абдуллаев; мама — выпускница консерватории, преподаватель музыки. Детство прошло в Фергане.' },
      { t: 'Музыкальная школа', d: 'В школьные годы 7 лет училась в музыкальной школе по классу фортепиано и 5 лет — дутора, занималась хором и сольфеджио.' },
      { t: 'Слово и микрофон', d: 'Хотя могла стать музыкантом, выбрала академический лицей с углублённым английским, а затем — из любви к работе у микрофона — журналистику в вузе.' },
      { t: 'Школа печати', d: 'Начала журналистский путь в газете «Сугдиёна»: наставники учили, что перо и речь журналиста оттачиваются прежде всего в печати.' },
      { t: 'Радио', d: 'Много лет вела прямые эфиры на радио: Zamin FM, Hit FM, 90.8 FM и радио «Ёшлар». В эфирах и на мероприятиях часто выступала вместе с коллегой Озодом Равшаном.' },
      { t: 'Milliy TV', d: 'Вела просветительские и развлекательные передачи на телеканале «Миллий», в том числе утреннее шоу «Ширчой».' },
      { t: 'Телеканал «Севимли»', d: 'Авторские и развлекательные проекты, шоу и ток-шоу, в том числе «Bollivud battl». Сейчас — ведущая «Sevimli kun» и ток-шоу.' },
      { t: 'Эксперт и собеседник', d: 'Постоянный эксперт и собеседник в передачах телеканала «Ёшлар» и других национальных каналов («Жамулжам» и др.).' },
      { t: 'Тренер по ораторскому искусству', d: 'Проводит мастер-классы и тренинги: свободная речь перед аудиторией, постановка голоса, дикция, преодоление волнения.' },
      { t: 'Курсы для женщин', d: 'Авторские курсы о роли женщины в обществе, психологической независимости, культуре общения и технике речи.' },
      { t: 'Работа с молодёжью', d: 'Мастер-классы по теле- и радиоведению для студентов-журналистов; практические встречи со студентами вузов, например Государственного института искусств и культуры Узбекистана, о медиакультуре, искусстве речи и роли соцсетей.' },
      { t: 'Блогер', d: 'Почти полмиллиона подписчиков в соцсетях. Видео и размышления о личностном росте, семейных ценностях, женской психологии и культуре общения.' },
      { t: 'Фуд-блог', d: 'Честные обзоры ресторанов и национальных блюд по всему Узбекистану, кулинарные рецепты.' },
    ],
    valEy: 'Ценности', valH: 'Мои принципы работы',
    values: [
      { t: 'Искренность', d: 'В каждом эфире и на каждом мероприятии — слова от души.' },
      { t: 'Тщательная подготовка', d: 'Сценарий, гости и каждая минута продумываются заранее.' },
      { t: 'Национальные ценности', d: 'Уважение к традициям и современный стиль ведения.' },
    ],
    hobEy: 'Вне сцены', hobH: 'Мои увлечения',
    hobbies: [
      { t: 'Спорт', d: 'Регулярно занимаюсь фитнесом, боксом и муай-тай. Спорт — лучший способ справиться со стрессом и сохранить бодрость духа.' },
      { t: 'Аудиокниги', d: 'В свободное время слушаю художественную и психологическую литературу, книги о личностном росте.' },
    ],
    galEy: 'Достижения и СМИ', galH: 'Эфиры, награды, выступления',
    galNote: 'Нужен список наград, сертификатов и публикаций в СМИ — пока только фотографии.',
  },
}[lang];

const crumbs = [{ href: `/${lang}/about/`, label: T.crumb }];
const img = await getImage({ src: about, width: 800, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: new URL(`/${lang}/about/`, SITE.url).href,
  image: new URL(img.src, SITE.url).href,
  jobTitle: SITE.roles,
  sameAs: Object.values(SOCIAL).filter((u) => u && u !== 'https://t.me/'),
};
const gallery = [studio, yangiHayot, greenGown, radio, blueIkat, football];
---
<Base lang={lang} title={T.title} description={T.description} image={about} crumbs={crumbs} jsonLd={[person]}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={T.eyebrow}>
    {T.h1a}<em>{T.h1b}</em>{T.h1c}
  </PageHero>

  <section class="sec">
    <div class="wrap intro">
      <Image src={about} alt={SITE.name} widths={[480, 800]} sizes="(min-width:860px) 40vw, 100vw" class="portrait" loading="eager" />
      <div class="prose-q">
        <p class="hello">{T.hello}</p>
        {T.intro.map((p) => <p>{p}</p>)}
        {T.introNote && <p class="placeholder">{T.introNote}</p>}
      </div>
    </div>
  </section>

  <section class="sec onair">
    <div class="wrap">
      <div class="stats">
        {STATS.map((s) => <div><b>{s.n}{s.suffix && <small>{s.suffix}</small>}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">{T.pathEy}</p>
      <h2>{T.pathH}</h2>
      <ol class="tl">
        {T.path.map((p) => <li><b>{p.t}</b><p>{p.d}</p></li>)}
      </ol>
      <p class="note">{T.pathNote}</p>
    </div>
  </section>

  <section class="sec" style="background:#fff">
    <div class="wrap">
      <p class="eyebrow">{T.valEy}</p>
      <h2>{T.valH}</h2>
      <div class="vals">{T.values.map((v) => <div class="val"><h3>{v.t}</h3><p>{v.d}</p></div>)}</div>
    </div>
  </section>

  <section class="sec" style="padding-bottom:0">
    <div class="wrap">
      <p class="eyebrow">{T.hobEy}</p>
      <h2>{T.hobH}</h2>
      <div class="vals two">{T.hobbies.map((v) => <div class="val" style="background:#fff"><h3>{v.t}</h3><p>{v.d}</p></div>)}</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">{T.galEy}</p>
      <h2>{T.galH}</h2>
      <div class="gal">{gallery.map((g) => <Image src={g} alt="" widths={[360, 600]} sizes="(min-width:720px) 33vw, 50vw" loading="lazy" />)}</div>
      <p class="placeholder" style="margin-top:20px">{T.galNote}</p>
    </div>
  </section>
</Base>
<style>
  .intro { display: grid; gap: 32px; align-items: center; }
  .intro :global(.portrait) { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: 50% 25%; border-radius: var(--r); }
  .hello { font-family: var(--font-serif); font-size: 30px; font-weight: 700; line-height: 1.2; }
  @media (min-width: 860px) { .intro { grid-template-columns: .85fr 1.15fr; gap: 56px; } }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; gap: 8px; }
  .stats b { display: block; font-family: var(--font-serif); font-size: clamp(38px, 9vw, 72px); color: var(--color-rose-lt); line-height: 1; white-space: nowrap; }
  .stats small { font-size: .45em; }
  .stats span { font-size: 13px; opacity: .75; display: block; margin-top: 8px; }
  .tl { margin-top: 32px; border-left: 2px solid var(--color-line); padding-left: 24px; display: grid; gap: 26px; }
  .tl li { position: relative; }
  .tl li::before { content: ""; position: absolute; left: -32px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-rose); box-shadow: 0 0 0 4px var(--color-ivory); }
  .tl b { font-family: var(--font-serif); font-size: 24px; }
  .tl p { color: var(--color-muted); margin-top: 2px; }
  .vals { display: grid; gap: 14px; margin-top: 28px; }
  .val { padding: 24px; border-radius: var(--r); background: var(--color-ivory); }
  .val h3 { font-size: 26px; } .val p { color: var(--color-muted); margin-top: 6px; }
  @media (min-width: 720px) { .vals { grid-template-columns: repeat(3, 1fr); } .vals.two { grid-template-columns: repeat(2, 1fr); } }
  .gal { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 28px; }
  .gal :global(img) { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 14px; }
  @media (min-width: 720px) { .gal { grid-template-columns: repeat(3, 1fr); } }
</style>
