---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', class: cls } = Astro.props;
---

<div class:list={['mb-10 sm:mb-14', align === 'center' && 'mx-auto max-w-3xl text-center', cls]} data-reveal={Tag === 'h1' ? undefined : ''}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag class:list={[Tag === 'h1' ? 'text-5xl sm:text-6xl lg:text-7xl' : 'h-section']}>{title}</Tag>
  {lead && <p class:list={['lead mt-4', align === 'center' && 'mx-auto']}>{lead}</p>}
  <slot />
</div>
