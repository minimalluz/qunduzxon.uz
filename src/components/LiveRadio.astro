---
// Онлайн радио плеери (бош саҳифа). Оқим манзили: Keystatic → Умумий созламалар → Онлайн радио.
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { getSettings } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const { radio } = await getSettings();
---

{
  radio.stream && (
    <div
      data-radio
      data-stream={radio.stream}
      data-label-play={t('radio.play')}
      data-label-stop={t('radio.stop')}
      data-msg-idle={t('radio.idle')}
      data-msg-connecting={t('radio.connecting')}
      data-msg-onair={t('radio.onair')}
      data-msg-error={t('radio.error')}
      class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-stage p-6 text-on-stage sm:p-8"
    >
      <div class="flex items-center justify-between gap-3">
        <p class="eyebrow !text-gold">{t('radio.title')}</p>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tracking-wide uppercase">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full rounded-full bg-red-500 opacity-75 group-data-[state=playing]:animate-ping" />
            <span class="relative inline-flex size-2 rounded-full bg-red-500" />
          </span>
          {t('radio.live')}
        </span>
      </div>

      <h3 class="mt-6 font-display text-4xl sm:text-5xl">{radio.name}</h3>
      <p class="mt-2 text-sm text-on-stage/70">{t('radio.note')}</p>

      <div class="mt-auto pt-10">
        <div class="flex items-center gap-5">
          <button
            type="button"
            data-radio-btn
            aria-label={t('radio.play')}
            aria-pressed="false"
            class="grid size-20 shrink-0 place-items-center rounded-full bg-gold text-ink shadow-lg transition hover:scale-105 active:scale-95"
          >
            <Icon name="play" size={30} class="translate-x-0.5 group-data-[state=playing]:hidden group-data-[state=connecting]:hidden" />
            <Icon name="pause" size={30} class="hidden group-data-[state=playing]:block" />
            <span class="hidden size-8 animate-spin rounded-full border-[3px] border-ink/25 border-t-ink group-data-[state=connecting]:block" />
          </button>
          <div class="min-w-0 flex-1">
            <!-- эквалайзер: фақат эфирда ҳаракатланади -->
            <div class="flex h-8 items-end gap-1" aria-hidden="true">
              {[0.6, 1, 0.45, 0.8, 0.35, 0.9, 0.55, 0.75, 0.4, 0.95, 0.5, 0.7].map((h, i) => (
                <span
                  class="radio-bar w-1.5 rounded-full bg-gold/70"
                  style={`height:${Math.round(h * 100)}%;animation-delay:${i * 90}ms`}
                />
              ))}
            </div>
            <p data-radio-status role="status" aria-live="polite" class="mt-3 text-sm text-on-stage/75">{t('radio.idle')}</p>
          </div>
        </div>

        <div class="mt-6 flex items-center gap-4">
          <label class="flex flex-1 items-center gap-3 text-sm text-on-stage/70">
            <span class="sr-only">{t('radio.volume')}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /></svg>
            <input data-radio-vol type="range" min="0" max="1" step="0.05" value="0.8" class="h-1.5 flex-1 cursor-pointer accent-[var(--color-gold)]" />
          </label>
          {radio.site && (
            <a href={radio.site} target="_blank" rel="noopener" class="text-sm text-on-stage/70 underline-offset-4 hover:text-on-stage hover:underline">{t('radio.site')} ↗</a>
          )}
        </div>
      </div>
      <audio data-radio-audio preload="none" />
    </div>
  )
}

<style>
  .radio-bar { transform-origin: bottom; transform: scaleY(0.25); transition: transform 0.3s; }
  [data-state='playing'] .radio-bar { animation: radio-eq 0.9s ease-in-out infinite alternate; }
  @keyframes radio-eq { from { transform: scaleY(0.2); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { [data-state='playing'] .radio-bar { animation: none; transform: scaleY(0.7); } }
</style>

<script>
  // Жонли оқим: тўхтатилганда юклаб олиш ҳам тўхтайди, қайта бошланганда — янги ҳолатдан (эски буфер эмас)
  document.querySelectorAll<HTMLElement>('[data-radio]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-radio-audio]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-radio-btn]')!;
    const status = root.querySelector<HTMLElement>('[data-radio-status]')!;
    const vol = root.querySelector<HTMLInputElement>('[data-radio-vol]')!;
    const d = root.dataset;
    let wanted = false;

    const set = (state: 'idle' | 'connecting' | 'playing' | 'error') => {
      root.dataset.state = state;
      const playing = state === 'playing' || state === 'connecting';
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute('aria-label', (playing ? d.labelStop : d.labelPlay) ?? '');
      status.textContent = { idle: d.msgIdle, connecting: d.msgConnecting, playing: d.msgOnair, error: d.msgError }[state] ?? '';
    };
    const stop = (state: 'idle' | 'error' = 'idle') => {
      wanted = false;
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      set(state);
    };

    audio.volume = Number(vol.value);
    vol.addEventListener('input', () => (audio.volume = Number(vol.value)));

    btn.addEventListener('click', () => {
      if (wanted) return stop();
      wanted = true;
      // Бошқа аудио ва видеоларни тўхтатиш
      document.querySelectorAll<HTMLMediaElement>('audio, video').forEach((m) => m !== audio && !m.paused && m.pause());
      set('connecting');
      audio.src = `${d.stream}${d.stream!.includes('?') ? '&' : '?'}_=${Date.now()}`;
      audio.play().catch(() => wanted && stop('error'));
    });
    audio.addEventListener('playing', () => wanted && set('playing'));
    audio.addEventListener('waiting', () => wanted && set('connecting'));
    audio.addEventListener('error', () => wanted && stop('error'));
    // Сайтда бошқа видео ёки аудио бошланса — радио тўхтайди
    document.addEventListener('play', (e) => e.target !== audio && wanted && stop(), true);
    set('idle');
  });
</script>
