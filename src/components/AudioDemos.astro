---
import Icon from './Icon.astro';
import { useT, pick, type Lang } from '../i18n/ui';
import { getAudio } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const demos = await getAudio();
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    demos.map(({ data }) => (
      <li data-audio class="group card flex items-center gap-4 p-4 transition data-[playing]:border-gold sm:p-5">
        {data.file ? (
          <>
            <button
              type="button"
              data-audio-btn
              data-label-play={t('audio.play')}
              data-label-pause={t('audio.pause')}
              aria-label={t('audio.play')}
              aria-pressed="false"
              class="grid size-14 shrink-0 place-items-center rounded-full bg-ink text-bg transition hover:scale-105"
            >
              <Icon name="play" size={22} class="translate-x-px group-data-[playing]:hidden" />
              <Icon name="pause" size={22} class="hidden group-data-[playing]:block" />
            </button>
            <audio preload="none" src={data.file} />
          </>
        ) : (
          <span class="grid size-14 shrink-0 place-items-center rounded-full bg-surface-2 text-muted" title={t('audio.soon')}>
            <Icon name="mic" size={22} />
          </span>
        )}
        <div class="min-w-0 flex-1">
          <p class="font-display text-xl leading-tight">{lang === 'ru' && data.titleRu ? data.titleRu : data.title}</p>
          <p class="mt-0.5 truncate text-sm text-muted">{data.file ? pick(data.style, lang) : t('audio.soon')}</p>
          <div data-audio-seek class="mt-3 h-1.5 cursor-pointer overflow-hidden rounded-full bg-line">
            <div data-audio-bar class="h-full origin-left scale-x-0 rounded-full bg-gold transition-transform duration-200" />
          </div>
        </div>
        <span data-audio-time class="w-10 shrink-0 text-right text-xs text-muted tabular-nums" />
      </li>
    ))
  }
</ul>
