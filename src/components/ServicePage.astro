---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import VideoFacade from './VideoFacade.astro';
import Testimonials from './Testimonials.astro';
import Faq from './Faq.astro';
import LeadForm from './LeadForm.astro';
import Lightbox from './Lightbox.astro';
import AudioDemos from './AudioDemos.astro';
import { useT, href, type Lang } from '../i18n/ui';
import { services, type ServiceKey } from '../i18n/services';
import { getCases, getFaq, getTestimonials, getSettings } from '../lib/content';
import { serviceSchema, faqSchema, videoSchemas } from '../lib/schema';
import { getImage } from 'astro:assets';

interface Props {
  lang: Lang;
  service: ServiceKey;
}
const { lang, service } = Astro.props;
const t = useT(lang);
const copy = services[service][lang];
const site = Astro.site!;
// «Бўш санани текшириш» формаси админ панелдан ёқилади; ўчиқ бўлса, тугма «Банд қилиш» саҳифасига олиб боради
const showDateCheck = (await getSettings()).showDateCheck;

const cases = (await getCases()).filter((c) => c.data.category === service);
const videos = cases.filter((c) => c.data.video.url);
const photos = cases;
const hero = cases[0]?.data.image;
const faq = await getFaq(service);
const reviews = await getTestimonials(service);
const caseTitle = (c: (typeof cases)[number]) => (lang === 'ru' && c.data.titleRu ? c.data.titleRu : c.data.title);

const schema = [
  serviceSchema(lang, site, copy.title, copy.description, copy.path),
  faqSchema(lang, faq),
  ...(await videoSchemas(site, videos.map((c) => ({ name: caseTitle(c), url: c.data.video.url, image: c.data.image, date: c.data.date })))),
].filter(Boolean) as Record<string, unknown>[];

const full = await Promise.all(photos.map((c) => getImage({ src: c.data.image, width: 1400, format: 'webp' })));
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  ogImage={hero}
  crumbs={[
    { name: t('nav.services'), path: '/boshlovchi/' },
    { name: copy.title, path: copy.path },
  ]}
  schema={schema}
>
  <section class="container-site grid gap-10 pt-8 pb-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16 lg:pb-24">
    <div>
      <p class="eyebrow">{t('nav.services')}</p>
      <h1 class="mt-3 text-5xl sm:text-6xl lg:text-7xl">{copy.h1}</h1>
      <p class="lead mt-6">{copy.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={showDateCheck ? '#book' : href(lang, '/band-qilish/')} class="btn btn-primary">{t('services.book')} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    {
      hero && (
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-surface-2 lg:aspect-[4/5]">
          <Picture
            src={hero}
            alt={caseTitle(cases[0])}
            formats={['avif', 'webp']}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            layout="none"
          />
        </div>
      )
    }
  </section>

  <section class="section border-t border-line">
    <div class="container-site">
      <SectionHead title={t('services.style')} />
      <ul class="grid gap-4 md:grid-cols-3">
        {
          copy.style.map((s, i) => (
            <li class="card p-6 sm:p-8" data-reveal>
              <p class="font-display text-5xl text-gold">0{i + 1}</p>
              <h3 class="mt-4 text-2xl sm:text-3xl">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    service === 'tv' && (
      <section class="section bg-surface-2">
        <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
          <SectionHead title={t('audio.title')} lead={t('audio.lead')} />
          <AudioDemos lang={lang} />
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="section bg-stage text-on-stage">
        <div class="container-site">
          <SectionHead title={t('services.gallery')} />
          <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {photos.map((c, i) => (
              <li data-reveal>
                {c.data.video.url ? (
                  <VideoFacade poster={c.data.image} title={caseTitle(c)} src={c.data.video.url} vertical={c.data.video.vertical} playLabel={t('video.play')} sizes="(min-width:1024px) 25vw, 46vw" />
                ) : (
                  <a href={full[i].src} data-lightbox="service" data-caption={caseTitle(c)} class="group block aspect-[9/16] overflow-hidden rounded-3xl">
                    <Picture src={c.data.image} alt={caseTitle(c)} formats={['avif', 'webp']} widths={[300, 500, 700]} sizes="(min-width:1024px) 25vw, 46vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" layout="none" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHead title={t('services.steps')} />
      <ol class="space-y-3">
        {
          copy.steps.map((step, i) => (
            <li class="card flex items-center gap-5 p-5" data-reveal>
              <span class="grid size-12 shrink-0 place-items-center rounded-full bg-gold-soft font-display text-2xl text-gold">{i + 1}</span>
              <span class="font-medium">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    reviews.length > 0 && (
      <section class="section bg-surface-2">
        <div class="container-site">
          <SectionHead title={t('services.reviews')} />
          <Testimonials lang={lang} items={reviews} />
        </div>
      </section>
    )
  }

  {
    faq.length > 0 && (
      <section class="section">
        <div class="container-site max-w-4xl">
          <SectionHead title={t('services.faq')} />
          <Faq lang={lang} items={faq} />
        </div>
      </section>
    )
  }

  {showDateCheck && (
    <section class="section bg-surface-2" id="book">
      <div class="container-site max-w-4xl">
        <div class="card p-6 sm:p-10">
          <SectionHead title={t('services.book')} lead={t('book.lead')} class="!mb-8" />
          <LeadForm lang={lang} variant="service" purpose={service} />
        </div>
      </div>
    </section>
  )}

  <Lightbox />
</Base>
