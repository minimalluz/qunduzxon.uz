---
import { Image } from 'astro:assets';
import { getPartners } from '../lib/content';

const partners = await getPartners();
// Cheksiz karusel uchun ikki marta takrorlanadi
const loop = [...partners, ...partners];
---

<div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
  <ul class="marquee-track flex w-max items-center gap-4 sm:gap-6">
    {
      loop.map(({ data }, i) => (
        <li aria-hidden={i >= partners.length ? 'true' : undefined} class="shrink-0">
          {data.logo ? (
            <Image src={data.logo} alt={data.name} height={48} class="h-10 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0 sm:h-12" loading="lazy" />
          ) : (
            <span class="flex h-16 items-center rounded-2xl border border-line px-6 font-display text-xl whitespace-nowrap text-muted sm:text-2xl">{data.name}</span>
          )}
        </li>
      ))
    }
  </ul>
</div>
