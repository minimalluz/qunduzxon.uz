---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { langs, switchLang, useT, href, type Lang } from '../i18n/ui';
import { getSettings } from '../lib/content';
import defaultOg from '../assets/site/hero.jpg';

export interface Crumb {
  name: string;
  path: string; // tilsiz yo'l, masalan /food-blog/
}

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article' | 'profile';
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Header qorong'i hero ustida shaffof turadi */
  overlayHeader?: boolean;
  /** Hero rasmini preload qilish uchun (LCP) */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
}

const { lang, title, description, ogImage, ogType = 'website', crumbs = [], schema = [], noindex = false, overlayHeader = false, preloadImage } =
  Astro.props;
const t = useT(lang);
const settings = await getSettings();

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title.includes(t('site.name')) ? title : `${title} | ${t('site.name')}`;
const desc = description || t('site.description');
const og = await getImage({ src: ogImage ?? defaultOg, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, site).href;

const breadcrumbSchema =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: t('crumbs.home'), path: '/' }, ...crumbs].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(href(lang, c.path), site).href,
        })),
      }
    : null;

const sameAs = [settings.instagram, settings.telegram, settings.youtube, settings.tiktok, settings.facebook].filter(Boolean);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('site.name'),
  url: new URL(`/${lang}/`, site).href,
  inLanguage: lang,
  publisher: { '@type': 'Person', name: t('site.name'), sameAs },
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(Astro.url.pathname, l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url.pathname, 'uz'), site).href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'uz' ? 'uz_UZ' : 'ru_RU'} />
    <meta property="og:locale:alternate" content={lang === 'uz' ? 'ru_RU' : 'uz_UZ'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#120f0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-head" />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.replace('no-js', 'js');
        try {
          var s = localStorage.getItem('theme');
          var dark = s ? s === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          d.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {
          d.dataset.theme = 'light';
        }
      })();
    </script>

    <JsonLd data={[websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema]} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">
      {t('nav.skip')}
    </a>
    <Header lang={lang} overlay={overlayHeader} />
    <main id="main">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="container-site pt-24 text-sm text-muted sm:pt-28">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a href={href(lang)} class="hover:text-ink">{t('crumbs.home')}</a></li>
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                {i === crumbs.length - 1 ? (
                  <span aria-current="page" class="text-ink">{c.name}</span>
                ) : (
                  <a href={href(lang, c.path)} class="hover:text-ink">{c.name}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
