---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import ReviewCard from '../../../components/ReviewCard.astro';
import { useT, href, langStaticPaths, type Lang } from '../../../i18n/ui';
import { getReviews } from '../../../lib/content';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const reviews = await getReviews();

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: reviews.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(href(lang, `/food-blog/${r.id}/`), Astro.site).href,
    name: r.data.name,
  })),
};
---

<Base lang={lang} title={t('food.title')} description={t('food.lead') || t('site.description')} ogImage={reviews[0]?.data.cover} crumbs={[{ name: t('nav.food'), path: '/food-blog/' }]} schema={[itemList]}>
  <section class="container-site pt-8 pb-16 sm:pb-24">
    <SectionHead as="h1" title={t('food.title')} lead={t('food.lead')} />

    <div id="food-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((r) => <ReviewCard lang={lang} review={r} />)}
    </div>
  </section>
</Base>
