---
import Base from '../../layouts/Base.astro';
import { useT, langStaticPaths, type Lang } from '../../i18n/ui';
import { getSettings } from '../../lib/content';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const s = await getSettings();

const text =
  lang === 'uz'
    ? [
        ['Қандай маълумот йиғилади', 'Сайтдаги формалар орқали сиз юборган исм, телефон рақам, тадбир санаси ва изоҳ.'],
        ['Нима учун ишлатилади', 'Фақат мурожаатингизга жавоб бериш ва хизмат шартларини келишиш учун. Маълумотлар учинчи шахсларга сотилмайди ва берилмайди.'],
        ['Қандай сақланади', 'Аризалар шифрланган канал (HTTPS) орқали ёпиқ Telegram-чатга юборилади. Сайт маълумотлар базасида шахсий маълумот сақланмайди.'],
        ['Спамдан ҳимоя', 'Формалар Cloudflare Turnstile билан ҳимояланган. Бу хизмат ботларни аниқлаш учун техник маълумотларни (IP, браузер) текширади.'],
        ['Аналитика', 'Сайт ташрифлари cookie\'сиз Cloudflare Web Analytics ёрдамида умумий ҳолда ҳисобланади.'],
        ['Маълумотни ўчириш', `Маълумотларингизни ўчиришни сўраш учун ${s.email} манзилига ёзинг.`],
      ]
    : [
        ['Какие данные собираются', 'Имя, номер телефона, дата мероприятия и комментарий, которые вы отправляете через формы сайта.'],
        ['Для чего используются', 'Только для ответа на ваше обращение и согласования услуг. Данные не продаются и не передаются третьим лицам.'],
        ['Как хранятся', 'Заявки передаются по зашифрованному каналу (HTTPS) в закрытый Telegram-чат. Персональные данные в базе сайта не хранятся.'],
        ['Защита от спама', 'Формы защищены Cloudflare Turnstile. Сервис проверяет технические данные (IP, браузер) для выявления ботов.'],
        ['Аналитика', 'Посещения сайта считаются в обобщённом виде через Cloudflare Web Analytics без cookie.'],
        ['Удаление данных', `Чтобы запросить удаление ваших данных, напишите на ${s.email}.`],
      ];
---

<Base lang={lang} title={t('privacy.title')} crumbs={[{ name: t('privacy.title'), path: '/privacy-policy/' }]}>
  <article class="container-site max-w-3xl pt-8 pb-24">
    <h1 class="text-5xl sm:text-6xl">{t('privacy.title')}</h1>
    <div class="mt-10 space-y-8">
      {
        text.map(([h, p]) => (
          <section>
            <h2 class="text-2xl sm:text-3xl">{h}</h2>
            <p class="mt-3 leading-relaxed text-muted">{p}</p>
          </section>
        ))
      }
    </div>
  </article>
</Base>
